getgenv().uiLE.Connections = getgenv().uiLE.Connections or (function()
    local C = {}
    local store = {}

    C.track = function(category, conn)
        if not conn then return conn end
        store[category] = store[category] or {}
        table.insert(store[category], conn)
        return conn
    end

    C.disconnectCategory = function(category)
        local list = store[category]
        if not list then return end
        for _, conn in ipairs(list) do
            pcall(function() conn:Disconnect() end)
        end
        store[category] = {}
    end

    C.disconnectAll = function()
        for category in pairs(store) do
            C.disconnectCategory(category)
        end
    end

    return C
end)()
