--------------------------------------------------------------------
-- ФИЗИКА И ТЕЛЕПОРТ
--------------------------------------------------------------------
local function setNoClip(state)
	if noclipConn then
		noclipConn:Disconnect()
		noclipConn = nil
	end
	if state then
		noclipConn = RunService.Stepped:Connect(function()
			local char = player.Character
			if char then
				for _, part in ipairs(char:GetDescendants()) do
					if part:IsA("BasePart") and part.CanCollide then
						part.CanCollide = false
					end
				end
			end
		end)
	end
end

local function getCharParts()
	local char = player.Character or player.CharacterAdded:Wait()
	local hrp = char:WaitForChild("HumanoidRootPart", 10)
	local hum = char:WaitForChild("Humanoid", 10)
	return char, hrp, hum
end

local function equipTool()
	local char = player.Character
	if not char then return nil end
	local tool = char:FindFirstChildOfClass("Tool")
	if tool then return tool end

	local backpack = player:FindFirstChild("Backpack")
	if not backpack then return nil end

	tool = CONFIG.TOOL_NAME and backpack:FindFirstChild(CONFIG.TOOL_NAME) or backpack:FindFirstChildOfClass("Tool")
	if tool then
		tool.Parent = char
		return tool
	end
	return nil
end

-- Одиночный быстрый ТП (для Генератора, Коммуникации и ручного выбора)
local function quickTeleport(targetPos)
	local _, hrp, hum = getCharParts()
	if not hrp or not hum or hum.Health <= 0 then return end

	pcall(function()
		player:RequestStreamAroundAsync(targetPos, CONFIG.STREAM_TIMEOUT)
	end)

	local dest = CFrame.new(targetPos + Vector3.new(0, CONFIG.TELEPORT_HEIGHT_OFFSET, 0))
	for _ = 1, 5 do
		hrp.CFrame = dest
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
		task.wait(0.03)
	end
end

--------------------------------------------------------------------
-- БЕСКОНЕЧНЫЙ ТП К ТРУБЕ ДО ПОЛУЧЕНИЯ УРОНА
--------------------------------------------------------------------
local function teleportUntilDamage(pipe, updateStatus)
	pcall(function()
		player:RequestStreamAroundAsync(pipe.pos, CONFIG.STREAM_TIMEOUT)
	end)

	local destCFrame = CFrame.new(pipe.pos + Vector3.new(0, CONFIG.TELEPORT_HEIGHT_OFFSET, 0))

	while isRunning do
		local _, hrp, hum = getCharParts()
		if not hrp or not hum then
			task.wait(0.2)
			continue
		end

		-- Если персонаж мертв, ждем возрождения и повторяем эту же трубу
		if hum.Health <= 0 then
			updateStatus("Персонаж погиб, ждем респавн...", THEME.statusWarn)
			player.CharacterAdded:Wait()
			task.wait(1)
			continue
		end

		local tookDamage = false
		local lastHealth = hum.Health

		-- Подписка на изменение здоровья (с учетом возможной регенерации)
		local healthConn
		healthConn = hum.HealthChanged:Connect(function(newHealth)
			if newHealth > 0 and (lastHealth - newHealth) >= CONFIG.DAMAGE_EPSILON then
				tookDamage = true
			else
				lastHealth = newHealth
			end
		end)

		setNoClip(true)
		updateStatus(string.format("Удерживаем %s (ждем урон)...", pipe.name), THEME.btnAction)

		local lastHit = 0
		-- Телепортируем в точку каждые TP_LOOP_INTERVAL секунд, пока не пройдет урон
		while isRunning and not tookDamage and hum.Health > 0 do
			hrp.CFrame = destCFrame
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero

			if tick() - lastHit >= CONFIG.HIT_INTERVAL then
				lastHit = tick()
				local tool = equipTool()
				if tool then tool:Activate() end
			end

			task.wait(CONFIG.TP_LOOP_INTERVAL)
		end

		if healthConn then healthConn:Disconnect() end
		setNoClip(false)

		if tookDamage then
			updateStatus(string.format("Урон получен на %s! Переход...", pipe.name), THEME.statusOk)
			task.wait(CONFIG.BETWEEN_PIPES_PAUSE)
			return true
		end
	end

	return false
end

