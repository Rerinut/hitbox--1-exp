local isRunning = false
local isBusy = false          -- рабочий поток еще не завершился
local currentTween = nil
local noclipConnection = nil
local noclipChanged = {}      -- части, у которых мы отключили CanCollide

--------------------------------------------------------------------
-- ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ФИЗИКИ И ПЕРЕМЕЩЕНИЯ
--------------------------------------------------------------------
local function setNoClip(enabled)
	if noclipConnection then
		noclipConnection:Disconnect()
		noclipConnection = nil
	end

	if enabled then
		noclipConnection = RunService.Stepped:Connect(function()
			local char = player.Character
			if char then
				for _, part in ipairs(char:GetDescendants()) do
					if part:IsA("BasePart") and part.CanCollide then
						noclipChanged[part] = true
						part.CanCollide = false
					end
				end
			end
		end)
	else
		-- Возвращаем коллизии, которые отключили сами
		for part in pairs(noclipChanged) do
			if part.Parent then
				part.CanCollide = true
			end
		end
		table.clear(noclipChanged)
	end
end

-- Возвращает живого персонажа или nil, если он не появился за RESPAWN_WAIT
local function getCharacterParts()
	local deadline = tick() + CONFIG.RESPAWN_WAIT
	while isRunning and tick() < deadline do
		local char = player.Character
		if char then
			local hrp = char:FindFirstChild("HumanoidRootPart")
			local hum = char:FindFirstChildOfClass("Humanoid")
			if hrp and hum and hum.Health > 0 then
				return char, hrp, hum
			end
		end
		task.wait(0.25)
	end
	return nil
end

local function resetVelocity(hrp)
	if hrp then
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
	end
end

local function equipTool()
	local char = player.Character
	if not char then return nil end

	local tool = char:FindFirstChildOfClass("Tool")
	if tool then return tool end

	local backpack = player:FindFirstChild("Backpack")
	if not backpack then return nil end

	if CONFIG.TOOL_NAME then
		tool = backpack:FindFirstChild(CONFIG.TOOL_NAME)
	else
		tool = backpack:FindFirstChildOfClass("Tool")
	end

	if tool then
		tool.Parent = char
		return tool
	end
	return nil
end

-- Перемещение с предзагрузкой и гашением инерции
local function moveTo(targetPos)
	local char, hrp, hum = getCharacterParts()
	if not hrp then return false end

	pcall(function()
		player:RequestStreamAroundAsync(targetPos, CONFIG.STREAM_TIMEOUT)
	end)

	local destCFrame = CFrame.new(targetPos + Vector3.new(0, CONFIG.TELEPORT_HEIGHT_OFFSET, 0))

	if CONFIG.USE_TWEEN then
		setNoClip(true)
		resetVelocity(hrp)

		local distance = (hrp.Position - destCFrame.Position).Magnitude
		local duration = math.clamp(distance / CONFIG.TWEEN_SPEED, 0.1, 15)

		local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
		local tween = TweenService:Create(hrp, tweenInfo, {CFrame = destCFrame})
		currentTween = tween

		local finished = false
		local conn = tween.Completed:Connect(function() finished = true end)
		tween:Play()

		while not finished and isRunning and hum.Health > 0 do
			task.wait(0.05)
		end
		conn:Disconnect()

		if not finished then
			tween:Cancel() -- остановка или смерть персонажа
		end
		if currentTween == tween then
			currentTween = nil
		end

		resetVelocity(hrp)
		task.wait(0.15)
		setNoClip(false)
	else
		hrp.CFrame = destCFrame
		resetVelocity(hrp)
		task.wait(0.1)
	end

	if not hrp.Parent then return false end
	return (hrp.Position - destCFrame.Position).Magnitude < 10
end

--------------------------------------------------------------------
-- ОБРАБОТКА ТРУБЫ И КОНТРОЛЬ ПОЛУЧЕНИЯ УРОНА
--------------------------------------------------------------------
local function processPipe(pipe, updateStatus)
	local retries = 0

	while retries < CONFIG.MAX_PIPE_RETRIES and isRunning do
		local char, hrp, hum = getCharacterParts()
		if not hrp then
			if isRunning then
				updateStatus("Персонаж не возродился", THEME.statusErr)
			end
			return false
		end

		updateStatus(string.format("Полет к %s (попытка %d)", pipe.name, retries + 1), THEME.btnSelect)
		local reached = moveTo(pipe.pos)

		char, hrp, hum = getCharacterParts()
		if not hrp then return false end

		-- Проверка на откат сервером
		local dist = (hrp.Position - pipe.pos).Magnitude
		if not reached or dist > 10 then
			updateStatus("Обнаружен откат! Повторная синхронизация...", THEME.statusWarn)
			retries = retries + 1
			task.wait(0.4)
		else
			-- Мы на месте, ждем урон и активируем инструмент
			updateStatus(string.format("На точке %s: ожидание урона...", pipe.name), THEME.statusOk)

			local initialHealth = hum.Health
			local startTime = tick()
			local tookDamage = false
			local lastHit = 0

			while isRunning and (tick() - startTime) < CONFIG.DAMAGE_TIMEOUT do
				-- Персонаж умер или исчез
				if not hrp.Parent or hum.Health <= 0 then
					break
				end

				-- Проверка, не отбросил ли сервер персонажа во время ожидания
				if (hrp.Position - pipe.pos).Magnitude > 10 then
					updateStatus("Откат во время взаимодействия!", THEME.statusWarn)
					break
				end

				-- Автоудар инструментом
				if tick() - lastHit >= CONFIG.HIT_INTERVAL then
					lastHit = tick()
					local tool = equipTool()
					if tool then tool:Activate() end
				end

				-- Проверка фиксации урона
				if (initialHealth - hum.Health) >= CONFIG.DAMAGE_EPSILON then
					tookDamage = true
					break
				end

				task.wait(0.05)
			end

			if tookDamage then
				updateStatus(string.format("Урон получен на %s!", pipe.name), THEME.statusOk)
				task.wait(CONFIG.BETWEEN_PIPES_PAUSE)
				return true
			elseif isRunning then
				-- Урон не пришел: микродоводка к трубе
				updateStatus("Урон не зафиксирован, корректировка позиции...", THEME.statusWarn)
				retries = retries + 1
				if hrp.Parent then
					local offset = pipe.pos - hrp.Position
					if offset.Magnitude > 0.01 then
						hrp.CFrame = hrp.CFrame + offset.Unit * 0.5
					end
				end
				task.wait(0.3)
			end
		end
	end

	return false
end

