----------------------------------------------------------------
-- Обновление отображения
----------------------------------------------------------------
local buttons = {}

local function updateReport()
	local lines = {"Naramato | отчёт наблюдений"}
	for i = 1, #PIPES do
		local line = string.format("Труба %d: %s", i, statuses[i])
		if details[i] ~= "" then line = line .. " (" .. details[i] .. ")" end
		if runs[i] > 0 then
			line = line .. string.format(" [проверок: %d, последняя %s]", runs[i], lastTime[i])
		end
		table.insert(lines, line)
	end
	reportBox.Text = table.concat(lines, "\n")
end

local function updateInfo()
	if checking then return end
	local _, root = characterParts()
	local distText = "нет персонажа"
	if root then
		local zone = inZone(root, selected) and "в зоне" or "далеко"
		distText = string.format("%.1f studs · %s", flatDistance(root.Position, PIPES[selected]), zone)
	end
	local second = statuses[selected]
	if details[selected] ~= "" then second = second .. " | " .. details[selected] end
	info.Text = string.format("Труба %d | %s\n%s", selected, distText, second)
end

local function refresh()
	updateInfo()
	for i, b in ipairs(buttons) do
		local color = Color3.fromRGB(76, 79, 88)
		if statuses[i] == "Урон наблюдался" then color = Color3.fromRGB(130, 63, 60)
		elseif statuses[i] == "Урон не наблюдался" then color = Color3.fromRGB(41, 110, 76)
		elseif statuses[i] == "Проверка неполная" then color = Color3.fromRGB(135, 100, 42)
		elseif statuses[i] == "Проверяется" then color = Color3.fromRGB(60, 90, 140) end
		if i == selected then color = Color3.fromRGB(49, 98, 170) end
		b.BackgroundColor3 = color
		b.Text = string.format("%d | %s", i, statuses[i])
	end
	updateReport()
end

for i = 1, #PIPES do
	local index = i
	local b = instance("TextButton", choose, {
		Size = UDim2.new(1, -8, 0, 29), LayoutOrder = i,
		TextColor3 = Color3.new(1, 1, 1), TextSize = 12, Font = Enum.Font.Gotham,
		BackgroundColor3 = Color3.fromRGB(70, 75, 86),
	})
	instance("UICorner", b, {CornerRadius = UDim.new(0, 5)})
	buttons[i] = b
	listen(b.MouseButton1Click, function()
		if checking then return end
		selected = index
		refresh()
	end)
end

-- Живое обновление расстояния на панели
local acc = 0
listen(RunService.Heartbeat, function(dt)
	acc += dt
	if acc >= INFO_REFRESH then
		acc = 0
		updateInfo()
	end
end)

----------------------------------------------------------------
-- Проверка
----------------------------------------------------------------
local function finish(token, idx, status, detail)
	if runToken ~= token then return end
	disconnectCheck()
	statuses[idx] = status
	details[idx] = detail
	runs[idx] += 1
	lastTime[idx] = os.date("%H:%M:%S")
	checking = false
	checkingIndex = nil
	refresh()
end

local function stop()
	runToken += 1
	disconnectCheck()
	if checking and checkingIndex then
		statuses[checkingIndex] = "Проверка неполная"
		details[checkingIndex] = "остановлена"
	end
	checking = false
	checkingIndex = nil
	refresh()
end

local function runCheck()
	if checking then return end
	local humanoid, root = characterParts()
	if not humanoid or not root then
		info.Text = "Персонаж недоступен"
		return
	end
	if not inZone(root, selected) then
		info.Text = string.format("Подойди к трубе %d ближе %.0f studs", selected, MAX_DISTANCE)
		return
	end

	checking = true
	runToken += 1
	local token = runToken
	local pipeIndex = selected
	checkingIndex = pipeIndex
	local initialChar = player.Character
	local lastHealth = humanoid.Health
	local damage, peak, elapsed = 0, 0, 0
	local firstHit = nil
	statuses[pipeIndex] = "Проверяется"
	details[pipeIndex] = ""
	refresh()

	activeConnection = RunService.Heartbeat:Connect(function(dt)
		if runToken ~= token then return end
		local h, r = characterParts()
		if player.Character ~= initialChar or h ~= humanoid or not r
			or not inZone(r, pipeIndex) then
			finish(token, pipeIndex, "Проверка неполная", "персонаж вышел из зоны / погиб")
			return
		end

		if h.Health < lastHealth then
			local hit = lastHealth - h.Health
			damage += hit
			peak = math.max(peak, hit)
			firstHit = firstHit or elapsed
		end
		lastHealth = h.Health
		elapsed += dt

		info.Text = string.format("Труба %d: проверка %.1f/%.0f с\nУрон за время проверки: %.1f HP",
			pipeIndex, elapsed, CHECK_SECONDS, damage)

		if elapsed >= CHECK_SECONDS then
			if damage > 0 then
				finish(token, pipeIndex, "Урон наблюдался",
					string.format("%.1f HP/%.0fс · 1-й на %.1fс · пик %.1f", damage, CHECK_SECONDS, firstHit or 0, peak))
			else
				finish(token, pipeIndex, "Урон не наблюдался",
					string.format("0 HP за %.0f сек", CHECK_SECONDS))
			end
		end
	end)
end

----------------------------------------------------------------
-- Кнопки
----------------------------------------------------------------
listen(checkButton.MouseButton1Click, runCheck)
listen(stopButton.MouseButton1Click, stop)

listen(nextButton.MouseButton1Click, function()
	if checking then return end
	selected = selected % #PIPES + 1
	refresh()
end)

listen(nearestButton.MouseButton1Click, function()
	if checking then return end
	local _, root = characterParts()
	if not root then
		info.Text = "Персонаж недоступен"
		return
	end
	local best, bestDist = selected, math.huge
	for i = 1, #PIPES do
		local d = flatDistance(root.Position, PIPES[i])
		if d < bestDist then best, bestDist = i, d end
	end
	selected = best
	refresh()
end)

listen(resetButton.MouseButton1Click, function()
	if checking then return end
	for i = 1, #PIPES do
		statuses[i] = "Не проверена"
		details[i] = ""
		runs[i] = 0
		lastTime[i] = ""
	end
	refresh()
end)

listen(reportButton.MouseButton1Click, function()
	reportBox.Visible = not reportBox.Visible
	updateReport()
end)

listen(minimize.MouseButton1Click, function()
	panel.Visible = false
	open.Visible = true
	reportBox.Visible = false
end)

listen(open.MouseButton1Click, function()
	panel.Visible = true
	open.Visible = false
end)

listen(closeButton.MouseButton1Click, function()
	gui:Destroy()
end)

listen(UserInputService.InputBegan, function(input, processed)
	if not processed and input.KeyCode == HOTKEY then
		panel.Visible = not panel.Visible
		open.Visible = not panel.Visible
		if not panel.Visible then reportBox.Visible = false end
	end
end)

----------------------------------------------------------------
-- Перетаскивание окна
----------------------------------------------------------------
local dragging = false
local dragStart, frameStart

listen(header.InputBegan, function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		frameStart = panel.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then dragging = false end
		end)
	end
end)

listen(UserInputService.InputChanged, function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		panel.Position = UDim2.new(frameStart.X.Scale, frameStart.X.Offset + delta.X,
			frameStart.Y.Scale, frameStart.Y.Offset + delta.Y)
		placeReport()
	end
end)

----------------------------------------------------------------
-- Очистка при удалении GUI
----------------------------------------------------------------
listen(gui.Destroying, function()
	runToken += 1
	disconnectCheck()
	for _, c in ipairs(connections) do c:Disconnect() end
	table.clear(connections)
end)

refresh()
