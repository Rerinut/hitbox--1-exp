--------------------------------------------------------------------
-- МЕХАНИКА ТЕЛЕПОРТА И АНТИ-ОТКАТА
--------------------------------------------------------------------
local function setNoClip(state)
	if noclipConn then
		noclipConn:Disconnect()
		noclipConn = nil
	end
	if state then
		noclipConn = RunService.Stepped:Connect(function()
			local char = player.Character
			if char then
				for _, part in ipairs(char:GetDescendants()) do
					if part:IsA("BasePart") and part.CanCollide then
						part.CanCollide = false
					end
				end
			end
		end)
	end
end

local function getCharParts()
	local char = player.Character or player.CharacterAdded:Wait()
	local hrp = char:WaitForChild("HumanoidRootPart", 5)
	local hum = char:WaitForChild("Humanoid", 5)
	return char, hrp, hum
end

local function equipTool()
	local char = player.Character
	if not char then return nil end
	local tool = char:FindFirstChildOfClass("Tool")
	if tool then return tool end

	local backpack = player:FindFirstChild("Backpack")
	if not backpack then return nil end

	tool = CONFIG.TOOL_NAME and backpack:FindFirstChild(CONFIG.TOOL_NAME) or backpack:FindFirstChildOfClass("Tool")
	if tool then
		tool.Parent = char
		return tool
	end
	return nil
end

-- Мгновенный ТП с удержанием CFrame против сетевого отката
local function instantTeleport(targetPos)
	local char, hrp, hum = getCharParts()
	if not hrp or not hum or hum.Health <= 0 then return false end

	pcall(function()
		player:RequestStreamAroundAsync(targetPos, CONFIG.STREAM_TIMEOUT)
	end)

	local destCFrame = CFrame.new(targetPos + Vector3.new(0, CONFIG.TELEPORT_HEIGHT_OFFSET, 0))

	setNoClip(true)
	-- Фиксируем позицию на 6 кадров, чтобы сервер перезаписал старую координату
	for _ = 1, 6 do
		hrp.CFrame = destCFrame
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
		task.wait(0.03)
	end
	setNoClip(false)

	return (hrp.Position - destCFrame.Position).Magnitude < 8
end

--------------------------------------------------------------------
-- ЦИКЛ ТРУБЫ С КОНТРОЛЕМ УРОНА
--------------------------------------------------------------------
local function processPipe(pipe, updateStatus)
	local char, hrp, hum = getCharParts()
	if not hum or hum.Health <= 0 then return false end

	local retries = 0
	local target = pipe.pos

	while retries < CONFIG.MAX_PIPE_RETRIES and isRunning do
		updateStatus(string.format("ТП к %s...", pipe.name), THEME.btnAction)
		instantTeleport(target)

		char, hrp, hum = getCharParts()
		if not hrp or not hum or hum.Health <= 0 then return false end

		-- Проверка: удержались ли на точке после ТП
		if (hrp.Position - target).Magnitude > 8 then
			updateStatus("Откат сервера! Повтор ТП...", THEME.statusWarn)
			retries = retries + 1
			task.wait(0.2)
		else
			updateStatus(string.format("%s: ожидание урона...", pipe.name), THEME.statusOk)
			local initialHealth = hum.Health
			local start = tick()
			local tookDamage = false
			local lastHit = 0

			while isRunning and (tick() - start) < CONFIG.DAMAGE_TIMEOUT do
				-- Если во время ожидания сервер резко откинул назад — возвращаем на место
				if (hrp.Position - target).Magnitude > 8 then
					updateStatus("Откат в процессе! Возврат...", THEME.statusWarn)
					instantTeleport(target)
				end

				-- Удар инструментом
				if tick() - lastHit >= CONFIG.HIT_INTERVAL then
					lastHit = tick()
					local tool = equipTool()
					if tool then tool:Activate() end
				end

				-- Проверка урона
				if (initialHealth - hum.Health) >= CONFIG.DAMAGE_EPSILON then
					tookDamage = true
					break
				end

				task.wait(0.04)
			end

			if tookDamage then
				updateStatus(string.format("Урон получен: %s", pipe.name), THEME.statusOk)
				task.wait(CONFIG.BETWEEN_PIPES_PAUSE)
				return true
			else
				retries = retries + 1
				updateStatus("Нет урона, микро-доводка к трубе...", THEME.statusWarn)
				-- Смещаемся на 0.4 студа ближе к центру трубы
				target = pipe.pos + (pipe.pos - hrp.Position).Unit * 0.4
				task.wait(0.1)
			end
		end
	end
	return false
end

