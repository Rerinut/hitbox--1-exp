----------------------------------------------------------------
-- Вспомогательные функции
----------------------------------------------------------------
-- Возвращает char, hum, hrp или nil, если персонаж недоступен/мёртв
local function getCharacter()
	local char = player.Character
	if not char then return nil, nil, nil end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hum or hum.Health <= 0 or not hrp then return nil, nil, nil end
	return char, hum, hrp
end

local function flatDistance(a, b)
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

local function teleportTo(i)
	local char, _, hrp = getCharacter()
	if not hrp then return false end
	hrp.AssemblyLinearVelocity = Vector3.zero
	hrp.AssemblyAngularVelocity = Vector3.zero
	char:PivotTo(CFrame.new(PIPES[i] + Vector3.new(0, TELEPORT_HEIGHT, 0)))
	return true
end

local function faceTarget(hrp, targetPos)
	local currentPos = hrp.Position
	local flatTarget = Vector3.new(targetPos.X, currentPos.Y, targetPos.Z)
	if (flatTarget - currentPos).Magnitude > 0.1 then
		hrp.CFrame = CFrame.new(currentPos, flatTarget)
	end
end

local function findTool(container)
	if TOOL_NAME then
		local t = container:FindFirstChild(TOOL_NAME)
		return (t and t:IsA("Tool")) and t or nil
	end
	return container:FindFirstChildOfClass("Tool")
end

-- Гарантирует, что оружие в руках. nil = нет оружия или персонаж потерян.
local function ensureTool()
	local char, hum = getCharacter()
	if not char then return nil end
	local tool = findTool(char)
	if tool then return tool end

	local backpack = player:FindFirstChild("Backpack")
	tool = backpack and findTool(backpack)
	if not tool then return nil end

	hum:EquipTool(tool)
	task.wait(EQUIP_LOAD_DELAY) -- оружие инициализируется при экипировке
	return (tool.Parent == player.Character) and tool or nil
end

