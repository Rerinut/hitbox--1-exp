--------------------------------------------------------------------
-- ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ФИЗИКИ И ПЕРЕМЕЩЕНИЯ
--------------------------------------------------------------------
local function resetVelocity(hrp)
	if hrp and hrp.Parent then
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
	end
end

-- Включает/выключает NoClip и стабилизацию скорости в полете,
-- а при выключении возвращает исходные настройки CanCollide
local function setFlightMode(enabled)
	if flightConnection then
		flightConnection:Disconnect()
		flightConnection = nil
	end

	if enabled then
		flightConnection = RunService.Stepped:Connect(function()
			local char = player.Character
			if not char then return end

			local hrp = char:FindFirstChild("HumanoidRootPart")
			if hrp then
				resetVelocity(hrp)
			end

			for _, part in ipairs(char:GetDescendants()) do
				if part:IsA("BasePart") then
					if savedCollisions[part] == nil then
						savedCollisions[part] = part.CanCollide
					end
					if part.CanCollide then
						part.CanCollide = false
					end
				end
			end
		end)
	else
		for part, canCollide in pairs(savedCollisions) do
			if part and part.Parent then
				part.CanCollide = canCollide
			end
		end
		table.clear(savedCollisions)
	end
end

-- Возвращает живого персонажа, ожидая возрождения при необходимости
local function getAliveCharacterParts(updateStatus)
	local deadline = os.clock() + CONFIG.RESPAWN_WAIT

	while isRunning and os.clock() < deadline do
		local char = player.Character
		if char then
			local hrp = char:FindFirstChild("HumanoidRootPart")
			local hum = char:FindFirstChildOfClass("Humanoid")
			if hrp and hum and hum.Health > 0 and hum:GetState() ~= Enum.HumanoidStateType.Dead then
				return char, hrp, hum
			end
		end

		if updateStatus then
			updateStatus("Ожидание возрождения персонажа...", THEME.statusWarn)
		end
		task.wait(0.25)
	end

	local char = player.Character
	if char then
		local hrp = char:FindFirstChild("HumanoidRootPart")
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hrp and hum and hum.Health > 0 then
			return char, hrp, hum
		end
	end

	return nil, nil, nil
end

local function equipTool(char, hum)
	if not char or not hum or hum.Health <= 0 then return nil end

	local equipped = char:FindFirstChildOfClass("Tool")
	if equipped and (not CONFIG.TOOL_NAME or equipped.Name == CONFIG.TOOL_NAME) then
		return equipped
	end

	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then return nil end

	local tool = nil
	if CONFIG.TOOL_NAME then
		tool = backpack:FindFirstChild(CONFIG.TOOL_NAME)
	else
		tool = backpack:FindFirstChildOfClass("Tool")
	end

	if tool then
		hum:EquipTool(tool)
		return tool
	end

	return nil
end

-- Перемещение с предзагрузкой чанков и защитой от гравитационного рывка
local function moveTo(targetPos, updateStatus)
	local _, hrp, hum = getAliveCharacterParts(updateStatus)
	if not hrp or not hum then return false end

	pcall(function()
		player:RequestStreamAroundAsync(targetPos, CONFIG.STREAM_TIMEOUT)
	end)

	local destPos = targetPos + Vector3.new(0, CONFIG.TELEPORT_HEIGHT_OFFSET, 0)
	local destCFrame = CFrame.new(destPos)

	if CONFIG.USE_TWEEN then
		setFlightMode(true)
		resetVelocity(hrp)

		local distance = (hrp.Position - destPos).Magnitude
		local duration = math.clamp(distance / math.max(CONFIG.TWEEN_SPEED, 1), 0.05, 20)

		local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
		local tween = TweenService:Create(hrp, tweenInfo, {CFrame = destCFrame})
		currentTween = tween

		local finished = false
		local conn = tween.Completed:Connect(function()
			finished = true
		end)
		tween:Play()

		while not finished and isRunning and hum.Parent and hum.Health > 0 do
			task.wait(0.05)
		end

		conn:Disconnect()
		if currentTween == tween then
			tween:Cancel()
			currentTween = nil
		end

		resetVelocity(hrp)
		task.wait(0.1)
		setFlightMode(false)
	else
		resetVelocity(hrp)
		hrp.CFrame = destCFrame
		resetVelocity(hrp)
		task.wait(0.1)
	end

	if not hrp.Parent or hum.Health <= 0 then
		return false
	end

	return (hrp.Position - destPos).Magnitude <= CONFIG.ARRIVAL_TOLERANCE
end

--------------------------------------------------------------------
-- ОБРАБОТКА ТРУБЫ И КОНТРОЛЬ ПОЛУЧЕНИЯ УРОНА
--------------------------------------------------------------------
local function processPipe(pipe, updateStatus)
	local retries = 0
	local targetPos = pipe.pos + Vector3.new(0, CONFIG.TELEPORT_HEIGHT_OFFSET, 0)

	while retries < CONFIG.MAX_PIPE_RETRIES and isRunning do
		local char, hrp, hum = getAliveCharacterParts(updateStatus)
		if not char or not hrp or not hum then
			return false
		end

		updateStatus(string.format("Полет к %s (попытка %d/%d)", pipe.name, retries + 1, CONFIG.MAX_PIPE_RETRIES), THEME.btnSelect)
		local reached = moveTo(pipe.pos, updateStatus)

		char, hrp, hum = getAliveCharacterParts(updateStatus)
		if not char or not hrp or not hum then
			return false
		end

		-- Проверка на мгновенный откат сервером
		local dist = (hrp.Position - targetPos).Magnitude
		if not reached or dist > CONFIG.ARRIVAL_TOLERANCE then
			updateStatus("Обнаружен откат! Повторная синхронизация...", THEME.statusWarn)
			retries += 1
			task.wait(0.4)
		else
			-- На месте: отслеживаем любое падение здоровья через событие HealthChanged
			updateStatus(string.format("На точке %s: ожидание урона...", pipe.name), THEME.statusOk)

			local tookDamage = false
			local lastHealth = hum.Health

			local healthConn = hum.HealthChanged:Connect(function(newHealth)
				if (lastHealth - newHealth) >= CONFIG.DAMAGE_EPSILON or newHealth <= 0 then
					tookDamage = true
				end
				-- Если здоровье регенерирует, обновляем верхнюю планку
				if newHealth > lastHealth then
					lastHealth = newHealth
				end
			end)

			local startTime = os.clock()
			local lastHit = 0

			while isRunning and not tookDamage and (os.clock() - startTime) < CONFIG.DAMAGE_TIMEOUT do
				if not hrp.Parent or hum.Health <= 0 then
					tookDamage = true
					break
				end

				-- Проверка, не отбросил ли сервер персонажа во время ожидания
				if (hrp.Position - targetPos).Magnitude > CONFIG.ARRIVAL_TOLERANCE then
					updateStatus("Откат во время взаимодействия!", THEME.statusWarn)
					break
				end

				-- Автоудар инструментом при необходимости
				if (os.clock() - lastHit) >= CONFIG.HIT_INTERVAL then
					lastHit = os.clock()
					local tool = equipTool(char, hum)
					if tool then
						tool:Activate()
					end
				end

				task.wait(0.05)
			end

			healthConn:Disconnect()

			if tookDamage then
				updateStatus(string.format("Урон получен на %s!", pipe.name), THEME.statusOk)
				task.wait(CONFIG.BETWEEN_PIPES_PAUSE)
				return true
			else
				-- Если урон не пришел: безопасная микродоводка к центру трубы (без деления на 0)
				updateStatus("Урон не зафиксирован, корректировка позиции...", THEME.statusWarn)
				retries += 1
				if hrp and hrp.Parent then
					local delta = pipe.pos - hrp.Position
					local step = if delta.Magnitude > 0.001 then delta.Unit * 0.5 else Vector3.new(0, -0.25, 0)
					resetVelocity(hrp)
					hrp.CFrame = hrp.CFrame + step
				end
				task.wait(0.3)
			end
		end
	end

	return false
end

