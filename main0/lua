-- ЛОГИКА
--------------------------------------------------------------------
local currentRunId = 0

local function newRun()
	currentRunId += 1
	return currentRunId
end

-- Задача отменена: нажали «Остановить», запустили новую или GUI удалён (повторный запуск скрипта)
local function isCancelled(runId)
	return currentRunId ~= runId or screenGui.Parent == nil
end

local function getCharacterComponents()
	local char = player.Character
	if not char then return nil end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hum or hum.Health <= 0 or not hrp then return nil end
	return char, hum, hrp
end

-- Ждёт живого персонажа (в том числе после возрождения). nil, если отменено или не дождались
local function waitForCharacter(runId)
	local deadline = os.clock() + CONFIG.RESPAWN_WAIT
	while os.clock() < deadline do
		if isCancelled(runId) then return nil end
		local char, hum, hrp = getCharacterComponents()
		if char then return char, hum, hrp end
		task.wait(0.25)
	end
	return nil
end

-- Единая функция телепорта. Возвращает "ok" | "cancelled" | "noChar"
local function teleportTo(pos, runId)
	-- При включённом StreamingEnabled сначала подгружаем карту вокруг цели
	if workspace.StreamingEnabled then
		pcall(function()
			player:RequestStreamAroundAsync(pos, CONFIG.STREAM_TIMEOUT)
		end)
	end

	local target = CFrame.new(pos + Vector3.new(0, CONFIG.TELEPORT_HEIGHT_OFFSET, 0))

	for _ = 1, CONFIG.TELEPORT_ATTEMPTS do
		if isCancelled(runId) then return "cancelled" end

		-- Компоненты берём заново на каждой попытке: персонаж мог умереть или возродиться
		local char, _, hrp = waitForCharacter(runId)
		if not char then
			return isCancelled(runId) and "cancelled" or "noChar"
		end

		hrp.AssemblyLinearVelocity = Vector3.zero
		char:PivotTo(target)
		task.wait(CONFIG.TELEPORT_PAUSE)
	end

	if isCancelled(runId) then return "cancelled" end
	return "ok"
end

-- Возвращает подходящий инструмент (экипирует из рюкзака при необходимости)
local function getTool(char, hum)
	local wanted = CONFIG.TOOL_NAME

	local equipped = char:FindFirstChildOfClass("Tool")
	if equipped and (not wanted or equipped.Name == wanted) then
		return equipped
	end

	local backpack = player:FindFirstChildOfClass("Backpack")
	if backpack then
		local candidate
		if wanted then
			candidate = backpack:FindFirstChild(wanted)
		else
			candidate = backpack:FindFirstChildOfClass("Tool")
		end
		if candidate and candidate:IsA("Tool") then
			hum:EquipTool(candidate)
			task.wait(0.2)
			return candidate
		end
	end

	return nil
end

-- Обработка одной трубы.
-- Возвращает "damage" | "timeout" | "dead" | "noChar" | "cancelled"
local function processSinglePipe(pipeData, label, runId)
	setStatus("ТП к: " .. label)

	local tpResult = teleportTo(pipeData.pos, runId)
	if tpResult ~= "ok" then return tpResult end

	local char, hum = getCharacterComponents()
	if not char then return "dead" end

	local tool = getTool(char, hum)
	if not tool then
		setStatus("Инструмент не найден, жду урон: " .. label, COLORS.warn)
	else
		setStatus("Жду урон на: " .. label)
	end

	local lastHealth = hum.Health
	local waited = 0

	while waited < CONFIG.MAX_WAIT_PER_PIPE do
		if isCancelled(runId) then return "cancelled" end

		-- Каждую итерацию проверяем, что персонаж жив (актуальный Humanoid после респавна)
		char, hum = getCharacterComponents()
		if not char then return "dead" end

		-- Если инструмент убрали из рук, экипируем снова
		if not tool or tool.Parent ~= char then
			tool = getTool(char, hum)
		end
		if tool then
			pcall(function() tool:Activate() end)
		end

		task.wait(CONFIG.HIT_INTERVAL)
		waited += CONFIG.HIT_INTERVAL

		if isCancelled(runId) then return "cancelled" end

		-- Сравниваем с предыдущим тиком, а не с начальным значением:
		-- регенерация не маскирует урон
		if hum.Health < lastHealth - CONFIG.DAMAGE_EPSILON then
			task.wait(0.3)
			return isCancelled(runId) and "cancelled" or "damage"
		end
		lastHealth = hum.Health
	end

	return "timeout"
end

-- targetIndex = номер трубы или nil для всех труб
local function runWorkflow(targetIndex)
	local runId = newRun()

	task.spawn(function()
		local indices = {}
		if targetIndex then
			indices[1] = targetIndex
		else
			for i = 1, #PIPE_POSITIONS do
				indices[i] = i
			end
		end

		local damageCount = 0
		local timeoutNames = {}

		for n, idx in ipairs(indices) do
			local pipeData = PIPE_POSITIONS[idx]
			local label = string.format("%s (%d/%d)", pipeData.name, n, #indices)

			local result
			for attempt = 0, CONFIG.RETRIES_AFTER_DEATH do
				result = processSinglePipe(pipeData, label, runId)
				if result ~= "dead" then break end
				if attempt < CONFIG.RETRIES_AFTER_DEATH then
					setStatus("Погиб, повтор: " .. pipeData.name, COLORS.warn)
				end
			end

			if result == "cancelled" then
				return -- статус «Остановлено» уже выставлен кнопкой, не затираем
			elseif result == "noChar" or result == "dead" then
				setStatus("Прервано на " .. pipeData.name .. ": " .. RESULT_TEXT[result], COLORS.err)
				return
			elseif result == "damage" then
				damageCount += 1
				setStatus("Готово: " .. pipeData.name .. " (" .. RESULT_TEXT.damage .. ")", COLORS.ok)
			elseif result == "timeout" then
				table.insert(timeoutNames, pipeData.name)
				setStatus("Таймаут: " .. pipeData.name .. " (" .. RESULT_TEXT.timeout .. ")", COLORS.warn)
			end

			if n < #indices then
				task.wait(CONFIG.BETWEEN_PIPES_PAUSE)
			end
		end

		if isCancelled(runId) then return end

		if #timeoutNames == 0 then
			setStatus(
				targetIndex and ("Готово: " .. PIPE_POSITIONS[targetIndex].name) or "Все трубы пройдены!",
				COLORS.ok
			)
		else
			setStatus(
				string.format("Завершено. Урон: %d, таймаут: %s", damageCount, table.concat(timeoutNames, ", ")),
				COLORS.warn
			)
		end
	end)
end

-- ТП к одиночной локации
local function teleportToLocation(targetPos, locationName)
	local runId = newRun()

	task.spawn(function()
		setStatus("ТП к: " .. locationName)
		local result = teleportTo(targetPos, runId)

		if result == "ok" then
			setStatus("Готово: " .. locationName, COLORS.ok)
		elseif result == "noChar" then
			setStatus("Ошибка: нет персонажа", COLORS.err)
		end
		-- "cancelled": статус уже выставлен тем, кто отменил
	end)
end

