local noclipConnection = nil

--------------------------------------------------------------------
-- ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ФИЗИКИ И ПЕРЕМЕЩЕНИЯ
--------------------------------------------------------------------
local function setNoClip(enabled)
	if noclipConnection then
		noclipConnection:Disconnect()
		noclipConnection = nil
	end
	if enabled then
		noclipConnection = RunService.Stepped:Connect(function()
			local char = player.Character
			if char then
				for _, part in ipairs(char:GetDescendants()) do
					if part:IsA("BasePart") and part.CanCollide then
						part.CanCollide = false
					end
				end
			end
		end)
	end
end

local function getCharacterParts()
	local char = player.Character or player.CharacterAdded:Wait()
	local hrp = char:WaitForChild("HumanoidRootPart", 5)
	local hum = char:WaitForChild("Humanoid", 5)
	return char, hrp, hum
end

local function resetVelocity(hrp)
	if hrp then
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
	end
end

local function equipTool()
	local char = player.Character
	if not char then return nil end
	
	local tool = char:FindFirstChildOfClass("Tool")
	if tool then return tool end

	local backpack = player:FindFirstChild("Backpack")
	if not backpack then return nil end

	if CONFIG.TOOL_NAME then
		tool = backpack:FindFirstChild(CONFIG.TOOL_NAME)
	else
		tool = backpack:FindFirstChildOfClass("Tool")
	end

	if tool then
		tool.Parent = char
		return tool
	end
	return nil
end

-- Перемещение с предзагрузкой и гашением инерции
local function moveTo(targetPos)
	local char, hrp, hum = getCharacterParts()
	if not hrp or not hum or hum.Health <= 0 then return false end

	pcall(function()
		player:RequestStreamAroundAsync(targetPos, CONFIG.STREAM_TIMEOUT)
	end)

	local destCFrame = CFrame.new(targetPos + Vector3.new(0, CONFIG.TELEPORT_HEIGHT_OFFSET, 0))

	if CONFIG.USE_TWEEN then
		setNoClip(true)
		resetVelocity(hrp)

		local distance = (hrp.Position - destCFrame.Position).Magnitude
		local duration = math.clamp(distance / CONFIG.TWEEN_SPEED, 0.1, 15)

		local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
		currentTween = TweenService:Create(hrp, tweenInfo, {CFrame = destCFrame})

		local finished = false
		local conn = currentTween.Completed:Connect(function() finished = true end)
		currentTween:Play()

		while not finished and isRunning and hum.Health > 0 do
			task.wait(0.05)
		end
		conn:Disconnect()
		currentTween = nil

		resetVelocity(hrp)
		task.wait(0.15)
		setNoClip(false)
	else
		hrp.CFrame = destCFrame
		resetVelocity(hrp)
		task.wait(0.1)
	end

	return (hrp.Position - destCFrame.Position).Magnitude < 10
end

--------------------------------------------------------------------
-- ОБРАБОТКА ТРУБЫ И КОНТРОЛЬ ПОЛУЧЕНИЯ УРОНА
--------------------------------------------------------------------
local function processPipe(pipe, updateStatus)
	local retries = 0
	local char, hrp, hum = getCharacterParts()
	if not hum or hum.Health <= 0 then return false end

	while retries < CONFIG.MAX_PIPE_RETRIES and isRunning do
		updateStatus(string.format("Полет к %s (попытка %d)", pipe.name, retries + 1), THEME.btnSelect)
		local reached = moveTo(pipe.pos)

		char, hrp, hum = getCharacterParts()
		if not hrp or not hum or hum.Health <= 0 then return false end

		-- Проверка на мгновенный откат сервером
		local dist = (hrp.Position - pipe.pos).Magnitude
		if not reached or dist > 10 then
			updateStatus("Обнаружен откат! Повторная синхронизация...", THEME.statusWarn)
			retries = retries + 1
			task.wait(0.4)
		else
			-- Мы на месте, ждем урон и активируем инструмент
			updateStatus(string.format("На точке %s: ожидание урона...", pipe.name), THEME.statusOk)
			
			local initialHealth = hum.Health
			local startTime = tick()
			local tookDamage = false
			local lastHit = 0

			while isRunning and (tick() - startTime) < CONFIG.DAMAGE_TIMEOUT do
				-- Проверка, не отбросил ли сервер персонажа во время ожидания
				if (hrp.Position - pipe.pos).Magnitude > 10 then
					updateStatus("Откат во время взаимодействия!", THEME.statusWarn)
					break
				end

				-- Автоудар инструментом при необходимости
				if tick() - lastHit >= CONFIG.HIT_INTERVAL then
					lastHit = tick()
					local tool = equipTool()
					if tool then tool:Activate() end
				end

				-- Проверка фиксации урона
				if (initialHealth - hum.Health) >= CONFIG.DAMAGE_EPSILON then
					tookDamage = true
					break
				end

				task.wait(0.05)
			end

			if tookDamage then
				updateStatus(string.format("Урон получен на %s!", pipe.name), THEME.statusOk)
				task.wait(CONFIG.BETWEEN_PIPES_PAUSE)
				return true
			else
				-- Если урон не пришел: смещаемся на полстуда ближе к трубе (микродоводка)
				updateStatus("Урон не зафиксирован, корректировка позиции...", THEME.statusWarn)
				retries = retries + 1
				local nudge = (pipe.pos - hrp.Position).Unit * 0.5
				hrp.CFrame = hrp.CFrame + nudge
				task.wait(0.3)
			end
		end
	end

	return false
end

