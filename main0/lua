	Vector3.new(-3806.71, 98.50, 5093.26),
	Vector3.new(-3960.26, 106.50, 5281.30),
	Vector3.new(-3671.71, 93.50, 5389.35),
	Vector3.new(-3616.63, 93.50, 5278.25),
	Vector3.new(-3419.04, 93.50, 5230.96),
	Vector3.new(-3470.64, 93.50, 5412.19),
	Vector3.new(-3425.63, 95.00, 5463.00),
	Vector3.new(-3527.75, 93.50, 5588.77),
	Vector3.new(-3464.73, 110.50, 5665.48),
	Vector3.new(-3568.99, 93.50, 5742.89),
}

-- НАСТРОЙКИ
local CHECK_SECONDS = 5
local MAX_DISTANCE = 16      -- studs по горизонтали (X/Z)
local MAX_HEIGHT_DIFF = 30   -- допустимая разница по высоте (Y)
local INFO_REFRESH = 0.25    -- как часто обновлять расстояние на панели, сек
local HOTKEY = Enum.KeyCode.RightShift

-- СОСТОЯНИЕ
local statuses = table.create(#PIPES, "Не проверена")
local details = table.create(#PIPES, "")
local runs = table.create(#PIPES, 0)
local lastTime = table.create(#PIPES, "")
local selected = 1
local runToken = 0
local checking = false
local checkingIndex = nil
local activeConnection = nil
local connections = {}

local function listen(signal, callback)
	local c = signal:Connect(callback)
	table.insert(connections, c)
	return c
end

----------------------------------------------------------------
-- Вспомогательные функции
----------------------------------------------------------------
local function characterParts()
	local c = player.Character
	if not c then return end
	local h = c:FindFirstChildOfClass("Humanoid")
	local root = c:FindFirstChild("HumanoidRootPart")
	if h and root and h.Health > 0 then return h, root end
end

-- Расстояние по горизонтали: высота игрока над землёй не мешает проверке
local function flatDistance(a, b)
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

local function inZone(root, i)
	local p = PIPES[i]
	return flatDistance(root.Position, p) <= MAX_DISTANCE
		and math.abs(root.Position.Y - p.Y) <= MAX_HEIGHT_DIFF
end

local function distanceTo(i)
	local _, root = characterParts()
	if not root then return nil end
	return flatDistance(root.Position, PIPES[i])
end

local function disconnectCheck()
	if activeConnection then
		activeConnection:Disconnect()
		activeConnection = nil
	end
end

