local pipeButtons = {}

local function highlightPipe(index)
	for i, btn in ipairs(pipeButtons) do
		btn.BackgroundColor3 = (i == index) and COLOR_ACTIVE or COLOR_NORMAL
	end
end

local function updateProgress()
	if progIndex == 0 then
		progressLabel.Text = "Не запущено"
		return
	end
	local elapsed = math.floor(os.clock() - runStart)
	local text = string.format("Труба %d/%d", progIndex, progTotal)
	if progLap > 0 then
		text = text .. string.format(" · круг %d", progLap)
	end
	text = text .. string.format(" · %02d:%02d", math.floor(elapsed / 60), elapsed % 60)
	progressLabel.Text = text
end

-- Обновление таймера раз в секунду, пока идёт запуск
task.spawn(function()
	while screenGui.Parent do
		if isRunning then updateProgress() end
		task.wait(1)
	end
end)

----------------------------------------------------------------
-- Логика телепортации и атаки
-- Возвращает: "done" | "notool" | "cancelled" | "lost"
----------------------------------------------------------------
local function processSinglePipe(pipeData, myRunId)
	local function cancelled() return currentRunId ~= myRunId end
	if cancelled() then return "cancelled" end

	-- Телепорт с удержанием
	statusLabel.Text = "ТП (удержание): " .. pipeData.name
	for _ = 1, TELEPORT_ATTEMPTS do
		if cancelled() then return "cancelled" end
		local char, _, hrp = getCharacterComponents()
		if not hrp then return "lost" end
		hrp.AssemblyLinearVelocity = Vector3.zero
		char:PivotTo(CFrame.new(pipeData.pos + Vector3.new(0, 3, 0)))
		task.wait(TELEPORT_PAUSE)
	end

	local char, hum, hrp = getCharacterComponents()
	if not hrp then return "lost" end
	safeLookAt(hrp, pipeData.pos)

	statusLabel.Text = "Ожидание / Прицел: " .. pipeData.name
	task.wait(PIPE_DELAY)
	if cancelled() then return "cancelled" end

	char, hum = getCharacterComponents()
	if not char then return "lost" end

	-- Берём инструмент
	local tool = char:FindFirstChildOfClass("Tool")
	if not tool then
		local backpack = player:FindFirstChild("Backpack")
		if backpack then
			tool = backpack:FindFirstChildOfClass("Tool")
			if tool then
				hum:EquipTool(tool)
				task.wait(0.2)
			end
		end
	end

	if not tool then
		statusLabel.Text = "Нет инструмента: " .. pipeData.name
		return "notool"
	end

	-- Атака
	statusLabel.Text = "Атака: " .. pipeData.name
	if CHECK_BROKEN then
		local startT = os.clock()
		while os.clock() - startT < ATTACK_MAX_TIME do
			if cancelled() then return "cancelled" end
			if not getCharacterComponents() then return "lost" end
			local okCheck, broken = pcall(CHECK_BROKEN, pipeData)
			if okCheck and broken then break end
			pcall(function() tool:Activate() end)
			task.wait(ATTACK_PAUSE)
		end
	else
		for _ = 1, ATTACK_COUNT do
			if cancelled() then return "cancelled" end
			if not getCharacterComponents() then return "lost" end
			pcall(function() tool:Activate() end)
			task.wait(ATTACK_PAUSE)
		end
	end

	return "done"
end

-- Обёртка: при смерти ждёт респавн и повторяет ту же трубу
-- Возвращает: "done" | "notool" | "cancelled" | "failed"
local function processPipeWithRetry(pipeData, myRunId)
	for attempt = 1, MAX_RETRIES do
		local result = processSinglePipe(pipeData, myRunId)
		if result ~= "lost" then return result end

		statusLabel.Text = string.format("Персонаж потерян, жду респавн (%d/%d)", attempt, MAX_RETRIES)
		local char = waitForCharacter(myRunId, RESPAWN_TIMEOUT)
		if not char then
			return (currentRunId ~= myRunId) and "cancelled" or "failed"
		end
		task.wait(1)
	end
	return "failed"
end

local function finishRun(myRunId)
	if currentRunId == myRunId then
		isRunning = false
		updateProgress()
	end
end

local function runWorkflow(targetPipeIndex)
	currentRunId += 1
	local myRunId = currentRunId
	isRunning = true
	runStart = os.clock()
	progTotal = #PIPE_POSITIONS
	progLap = 0

	task.spawn(function()
		if targetPipeIndex then
			progIndex = targetPipeIndex
			highlightPipe(targetPipeIndex)
			updateProgress()
			local pipeData = PIPE_POSITIONS[targetPipeIndex]
			local result = processPipeWithRetry(pipeData, myRunId)
			if result == "done" and currentRunId == myRunId then
				statusLabel.Text = "Готово: " .. pipeData.name
			elseif result == "failed" and currentRunId == myRunId then
				statusLabel.Text = "Не удалось: " .. pipeData.name
			end
			finishRun(myRunId)
			return
		end

		local lap = 0
		local keepGoing = true
		while keepGoing do
			lap += 1
			progLap = lap
			for i, pipeData in ipairs(PIPE_POSITIONS) do
				if currentRunId ~= myRunId then return end
				progIndex = i
				highlightPipe(i)
				updateProgress()

				local result = processPipeWithRetry(pipeData, myRunId)
				if result == "cancelled" then return end
				if result == "failed" then
					statusLabel.Text = "Прервано: " .. pipeData.name
					finishRun(myRunId)
					return
				end
				task.wait(0.5)
			end

			if currentRunId ~= myRunId then return end
			keepGoing = loopEnabled
			if keepGoing then
				statusLabel.Text = "Круг " .. lap .. " пройден, начинаю новый"
				task.wait(1)
			end
		end

		if currentRunId == myRunId then
			statusLabel.Text = "Все трубы пройдены!"
			finishRun(myRunId)
		end
	end)
end

local function stopRun()
	currentRunId += 1
	isRunning = false
	statusLabel.Text = "Остановлено"
end

