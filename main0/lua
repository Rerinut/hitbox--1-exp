----------------------------------------------------------------
local pipeButtons = {}

local function setStatus(text)
	statusLabel.Text = text
end

local function refresh()
	for i, b in ipairs(pipeButtons) do
		local color = Color3.fromRGB(70, 75, 86)
		local s = statuses[i]
		if s == "Готово" then color = Color3.fromRGB(41, 110, 76)
		elseif s == "В работе" then color = Color3.fromRGB(49, 98, 170)
		elseif s == "Прервано" or s == "Нет оружия" then color = Color3.fromRGB(135, 100, 42) end
		b.BackgroundColor3 = color
		b.Text = string.format("Труба %d | %s", i, s)
	end
end

local function updateProgress()
	if progIndex == 0 then
		progressLabel.Text = "Не запущено"
		return
	end
	local elapsed = math.floor(os.clock() - runStart)
	local text = string.format("Труба %d/%d", progIndex, #PIPES)
	if progLap > 0 then text = text .. string.format(" · круг %d", progLap) end
	text = text .. string.format(" · %02d:%02d", math.floor(elapsed / 60), elapsed % 60)
	progressLabel.Text = text
end

-- Таймер раз в секунду, пока идёт запуск
task.spawn(function()
	while gui.Parent do
		if running then updateProgress() end
		task.wait(1)
	end
end)

----------------------------------------------------------------
-- Уничтожение одной трубы
-- Возвращает: "done" | "cancelled" | "lost" | "notool"
----------------------------------------------------------------
local function processPipe(idx, token)
	local function cancelled() return runToken ~= token end
	if cancelled() then return "cancelled" end

	local label = "Труба " .. idx
	statuses[idx] = "В работе"
	refresh()

	-- 1) телепорт (несколько попыток подряд: сервер может откатывать)
	setStatus("ТП (удержание): " .. label)
	for _ = 1, TELEPORT_ATTEMPTS do
		if cancelled() then return "cancelled" end
		if not teleportTo(idx) then return "lost" end
		task.wait(TELEPORT_PAUSE)
	end

	-- 2) прицел
	local _, _, hrp = getCharacter()
	if not hrp then return "lost" end
	faceTarget(hrp, PIPES[idx])
	setStatus("Прицел: " .. label)
	task.wait(PIPE_DELAY)
	if cancelled() then return "cancelled" end

	-- 3) оружие
	setStatus("Оружие: " .. label)
	local tool = ensureTool()
	if not tool then
		return getCharacter() and "notool" or "lost"
	end

	-- 4) атака с удержанием позиции
	local startT = os.clock()
	local hits, rubber = 0, 0
	while true do
		if cancelled() then return "cancelled" end
		local _, _, r = getCharacter()
		if not r then return "lost" end

		-- сервер мог откатить назад: возвращаем на трубу
		if flatDistance(r.Position, PIPES[idx]) > HOLD_RADIUS then
			rubber += 1
			teleportTo(idx)
			task.wait(0.15)
			local _, _, r2 = getCharacter()
			if r2 then faceTarget(r2, PIPES[idx]) end
		end

		if CHECK_BROKEN then
			local okc, broken = pcall(CHECK_BROKEN, idx)
			if okc and broken then break end
		elseif hits >= ATTACK_COUNT then
			break
		end
		if os.clock() - startT >= ATTACK_MAX_TIME then break end

		tool = ensureTool() -- оружие могло слететь
		if not tool then
			return getCharacter() and "notool" or "lost"
		end
		pcall(function() tool:Activate() end)
		hits += 1
		setStatus(string.format("Атака: %s · удар %d%s", label, hits,
			rubber > 0 and (" · откатов ТП: " .. rubber) or ""))
		task.wait(ATTACK_PAUSE)
	end

	return "done"
end

-- Обёртка: после смерти ждём респавн и повторяем ту же трубу
-- Возвращает: "done" | "cancelled" | "failed" | "notool" | "gaveup"
local function processWithRetry(idx, token)
	for attempt = 1, MAX_RETRIES do
		local result = processPipe(idx, token)
		if result ~= "lost" then return result end

		setStatus(string.format("Персонаж потерян, жду респавн (%d/%d)", attempt, MAX_RETRIES))
		local waited = 0
		while waited < RESPAWN_TIMEOUT and not getCharacter() do
			if runToken ~= token then return "cancelled" end
			task.wait(0.5)
			waited += 0.5
		end
		if not getCharacter() then return "failed" end
		task.wait(1)
	end
	return "gaveup"
end

----------------------------------------------------------------
-- Запуск
----------------------------------------------------------------
local function returnHome(pivot)
	if not (returnEnabled and pivot) then return end
	for _ = 1, 2 do
		local char, _, hrp = getCharacter()
		if not hrp then return end
		hrp.AssemblyLinearVelocity = Vector3.zero
		char:PivotTo(pivot)
		task.wait(0.3)
	end
end

local function runWorkflow(list, allowLoop)
	if running then return end
	if not getCharacter() then
		setStatus("Персонаж недоступен")
		return
	end

	runToken += 1
	local token = runToken
	running = true
	runStart = os.clock()
	progLap = 0
	progIndex = 0
	local startPivot = player.Character:GetPivot()
	local finalText = "Готово"

	task.spawn(function()
		local ok, err = pcall(function()
			local keepGoing = true
			local lap = 0
			while keepGoing do
				lap += 1
				progLap = allowLoop and lap or 0
				if lap > 1 then
					for i = 1, #PIPES do statuses[i] = "Ожидает" end
					refresh()
				end

				for n, idx in ipairs(list) do
					if runToken ~= token then return end
					progIndex = idx
					updateProgress()

					local result = processWithRetry(idx, token)
					if result == "done" then
						statuses[idx] = "Готово"
						setStatus("Готово: Труба " .. idx)
					elseif result == "cancelled" then
						return
					elseif result == "notool" then
						statuses[idx] = "Нет оружия"
						finalText = "Нет оружия в рюкзаке — остановлено"
						return
					elseif result == "failed" then
						statuses[idx] = "Прервано"
						finalText = "Не дождался респавна — остановлено"
						return
					else -- gaveup
						statuses[idx] = "Прервано"
						setStatus(string.format("Труба %d: персонаж погиб %d раз подряд", idx, MAX_RETRIES))
					end
					refresh()
					task.wait(PAUSE_BETWEEN)
				end

				if runToken ~= token then return end
				keepGoing = allowLoop and loopEnabled
				if keepGoing then
					setStatus("Круг " .. lap .. " пройден, начинаю новый")
					task.wait(1)
				else
					finalText = (#list > 1) and "Все трубы пройдены!" or finalText
				end
			end
		end)

		-- завершение (в том числе после остановки)
		for i = 1, #PIPES do
			if statuses[i] == "В работе" then statuses[i] = "Прервано" end
		end
		returnHome(startPivot)
		running = false
		updateProgress()
		refresh()

		if not ok then
			setStatus("Ошибка: " .. tostring(err))
		elseif runToken ~= token then
			setStatus("Остановлено")
		else
			setStatus(finalText)
		end
	end)
end

local function stop()
	if running then
		runToken += 1 -- поток сам завершится, вернёт на место и снимет флаг running
		setStatus("Останавливаю...")
	end
end

