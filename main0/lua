-- [NEW] fetchAndCacheScript — загрузка скрипта с сети + локальный
-- кэш-фоллбэк на случай, если GitHub/Rubis недоступны
-- ==================================================================
local function fetchAndCacheScript(urls, cacheFile)
    for _, url in ipairs(urls) do
        local content = fetchUrlList({url})
        if content and content ~= "" then
            if writefile then
                local okw = pcall(function() writefile(cacheFile, content) end)
                if okw then Logger.info("Cached script to " .. cacheFile) end
            end
            local func, err = loadstring(content)
            if func then
                local ok, result = pcall(func)
                if ok then
                    return result
                else
                    Logger.warn("Execution failed for " .. url .. ": " .. tostring(result))
                end
            else
                Logger.warn("loadstring failed for " .. url .. ": " .. tostring(err))
            end
        end
    end

    if isfile and readfile and isfile(cacheFile) then
        local okr, cached = pcall(readfile, cacheFile)
        if okr and cached and cached ~= "" then
            local func = loadstring(cached)
            if func then
                local ok2, result = pcall(func)
                if ok2 then
                    Logger.warn("Loaded from local cache (offline fallback): " .. cacheFile)
                    return result
                end
            end
        end
    end

    Logger.error("Failed to load script from network and cache: " .. cacheFile)
    return nil
end

