	end
end)

-- Логика телепортации и атаки с многократным подтверждением позиции
local function processSinglePipe(pipeData, myRunId)
	if currentRunId ~= myRunId then return false end
	
	local char, hum, hrp = getCharacterComponents()
	if not hrp then return false end
	
	statusLabel.Text = "ТП (удержание): " .. pipeData.name
	
	-- Несколько раз подряд принудительно устанавливаем позицию, чтобы сервер «сдался» и перестал откатывать
	for attempt = 1, TELEPORT_ATTEMPTS do
		if currentRunId ~= myRunId then return false end
		
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.CFrame = CFrame.new(pipeData.pos + Vector3.new(0, 3, 0))
		
		task.wait(TELEPORT_PAUSE)
	end
	
	local _, _, currentHrp = getCharacterComponents()
	if not currentHrp then return false end
	
	safeLookAt(currentHrp, pipeData.pos)
	
	-- Достаем оружие
	local equippedTool = char:FindFirstChildOfClass("Tool")
	if not equippedTool then
		local backpack = player:FindFirstChild("Backpack")
		if backpack then
			equippedTool = backpack:FindFirstChildOfClass("Tool")
			if equippedTool and hum then
				hum:EquipTool(equippedTool)
				task.wait(0.2)
			end
		end
	end
	
	statusLabel.Text = "Атака: " .. pipeData.name
	if equippedTool then
		for _ = 1, 4 do
			if currentRunId ~= myRunId then return false end
			pcall(function() equippedTool:Activate() end)
			task.wait(0.15)
		end
	end
	
	statusLabel.Text = "Готово: " .. pipeData.name
	return true
end

-- Запуск маршрута
local function runWorkflow(targetPipeIndex)
	currentRunId += 1
	local myRunId = currentRunId
	
	task.spawn(function()
		if targetPipeIndex then
			selectedPipeIndex = targetPipeIndex
			processSinglePipe(PIPE_POSITIONS[targetPipeIndex], myRunId)
			statusLabel.Text = "Готово: " .. PIPE_POSITIONS[targetPipeIndex].name
		else
			for i, pipeData in ipairs(PIPE_POSITIONS) do
				if currentRunId ~= myRunId then break end
				selectedPipeIndex = i
				local ok = processSinglePipe(pipeData, myRunId)
				if not ok then break end
				task.wait(0.2)
			end
			if currentRunId == myRunId then
				statusLabel.Text = "Все трубы пройдены!"
			end
		end
	end)
end

