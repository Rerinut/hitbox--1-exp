		open.Visible = not panel.Visible
	end
end)

----------------------------------------------------------------
-- Перетаскивание окна
----------------------------------------------------------------
local dragging = false
local dragStart, frameStart

listen(header.InputBegan, function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		frameStart = panel.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then dragging = false end
		end)
	end
end)

listen(UserInputService.InputChanged, function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		panel.Position = UDim2.new(frameStart.X.Scale, frameStart.X.Offset + delta.X,
			frameStart.Y.Scale, frameStart.Y.Offset + delta.Y)
	end
end)

----------------------------------------------------------------
-- Очистка при удалении GUI
----------------------------------------------------------------
listen(gui.Destroying, function()
	runToken += 1 -- активный поток завершится сам
	for _, c in ipairs(connections) do c:Disconnect() end
	table.clear(connections)
end)

refresh()
