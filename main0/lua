local buttons = {}

local function updateInfo()
	if checking then return end
	if summaryText ~= "" then
		info.Text = summaryText
		return
	end
	local second = statuses[selected]
	if details[selected] ~= "" then second = second .. " | " .. details[selected] end
	info.Text = string.format("Труба %d\n%s", selected, second)
end

local function refresh()
	updateInfo()
	for i, b in ipairs(buttons) do
		local color = Color3.fromRGB(76, 79, 88)
		if statuses[i] == "Урон наблюдался" then color = Color3.fromRGB(130, 63, 60)
		elseif statuses[i] == "Урон не наблюдался" then color = Color3.fromRGB(41, 110, 76)
		elseif statuses[i] == "Проверка неполная" then color = Color3.fromRGB(135, 100, 42)
		elseif statuses[i] == "Проверяется" then color = Color3.fromRGB(60, 90, 140) end
		if i == selected then color = Color3.fromRGB(49, 98, 170) end
		b.BackgroundColor3 = color
		b.Text = string.format("%d | %s", i, statuses[i])
	end
end

for i = 1, #PIPES do
