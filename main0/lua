getgenv().uiLE.Logger = getgenv().uiLE.Logger or (function()
    local L = {}
    L.enabled = true
    L.level = "warn" -- "info" | "warn" | "error" | "silent"
    local levelOrder = { info = 1, warn = 2, error = 3, silent = 4 }

    local function shouldLog(msgLevel)
        if not L.enabled then return false end
        return levelOrder[msgLevel] >= levelOrder[L.level]
    end

    local function fmt(tag, msg)
        return string.format("[AXIOS][%s] %s", tag, tostring(msg))
    end

    L.info = function(msg)
        if shouldLog("info") then print(fmt("INFO", msg)) end
    end
    L.warn = function(msg)
        if shouldLog("warn") then warn(fmt("WARN", msg)) end
    end
    L.error = function(msg)
        if shouldLog("error") then warn(fmt("ERROR", msg)) end
    end
    L.setLevel = function(lvl)
        if levelOrder[lvl] then L.level = lvl end
    end
    L.setEnabled = function(v)
        L.enabled = v and true or false
    end
    return L
end)()
