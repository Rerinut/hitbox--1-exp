local function getCharacterComponents()
	local char = player.Character
	if not char then return nil, nil, nil end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hum or hum.Health <= 0 or not hrp then return nil, nil, nil end
	return char, hum, hrp
end

local function safeLookAt(hrp, targetPos)
	local currentPos = hrp.Position
	local flatTarget = Vector3.new(targetPos.X, currentPos.Y, targetPos.Z)
	if (flatTarget - currentPos).Magnitude > 0.1 then
		hrp.CFrame = CFrame.new(currentPos, flatTarget)
	end
end

