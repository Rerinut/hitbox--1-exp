-- УДЕРЖАНИЕ ПО ВРЕМЕНИ (ДЛЯ ГЕНЕРАТОРА И КОММУНИКАЦИЙ)
--------------------------------------------------------------------
local function holdAtPointTimed(targetPos, pointName, duration, updateStatus)
	pcall(function()
		player:RequestStreamAroundAsync(targetPos, CONFIG.STREAM_TIMEOUT)
	end)

	local basePos = targetPos + Vector3.new(0, CONFIG.TELEPORT_HEIGHT_OFFSET, 0)
	local destCFrame = CFrame.new(basePos)
	local heldTime = 0
	local lastTick = tick()

	setNoClip(true)

	while isRunning and heldTime < duration do
		local _, hrp, hum = getCharParts()
		if not hrp or not hum or hum.Health <= 0 or not hrp.Parent then
			break
		end

		local now = tick()
		local dt = now - lastTick
		lastTick = now

		-- Проверяем, не отбросил ли сервер: засчитываем время только когда персонаж реально на точке
		local currentDist = (hrp.Position - basePos).Magnitude
		if currentDist <= CONFIG.MAX_VALID_DIST then
			heldTime = heldTime + dt
			local remaining = math.max(0, duration - heldTime)
			updateStatus(string.format("%s: удержание (%.1fс)...", pointName, remaining), THEME.btnSpecial)
		else
			updateStatus(string.format("%s: откат! Возвращаем...", pointName), THEME.statusWarn)
		end

		hrp.CFrame = destCFrame
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero

		task.wait(CONFIG.TP_LOOP_INTERVAL)
	end

	setNoClip(false)

	-- Финальное гашение скорости после отпускания
	local _, hrp = getCharParts()
	if hrp and hrp.Parent then
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
	end

	return heldTime >= duration
end

