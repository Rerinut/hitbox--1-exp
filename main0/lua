	local b = instance("TextButton", choose, {
		Size = UDim2.new(1, -8, 0, 29), LayoutOrder = i,
		TextColor3 = Color3.new(1, 1, 1), TextSize = 12, Font = Enum.Font.Gotham,
		BackgroundColor3 = Color3.fromRGB(70, 75, 86),
	})
	instance("UICorner", b, {CornerRadius = UDim.new(0, 5)})
	buttons[i] = b
	listen(b.MouseButton1Click, function()
		if checking then return end
		selected = index
		summaryText = ""
		refresh()
	end)
end

----------------------------------------------------------------
-- Проверка одной трубы
-- Возвращает: "done" | "cancelled" | "lost"
----------------------------------------------------------------
local function finishPipe(idx, status, detail)
	statuses[idx] = status
	details[idx] = detail
	refresh()
end

local function damageDetail(damage, firstHit, peak, rubber)
	local s = string.format("%.1f HP · 1-й %.1fс · пик %.1f", damage, firstHit or 0, peak)
	if rubber > 0 then s = s .. string.format(" · откатов %d", rubber) end
	return s
end

local function checkPipe(idx, token)
	local function cancelled() return runToken ~= token end
	if cancelled() then return "cancelled" end

	statuses[idx] = "Проверяется"
	details[idx] = ""
	refresh()

	-- 1) телепорт (несколько попыток подряд)
	if teleportEnabled then
		for _ = 1, TELEPORT_ATTEMPTS do
			if cancelled() then return "cancelled" end
			if not teleportTo(idx) then return "lost" end
			task.wait(TELEPORT_PAUSE)
		end
	end

	local humanoid, root = characterParts()
	if not humanoid or not root then return "lost" end

	if not inZone(root, idx) and not (teleportEnabled and flatDistance(root.Position, PIPES[idx]) <= HOLD_RADIUS) then
		finishPipe(idx, "Проверка неполная",
			teleportEnabled and "ТП не сработало (сервер вернул назад)" or "далеко от трубы")
		return "done"
	end

	-- 2) наблюдение
	local initialChar = player.Character
	local settle = teleportEnabled and SETTLE_TIME or 0
	local total = settle + CHECK_SECONDS
	local lastHealth = humanoid.Health
	local damage, peak, firstHit, rubber = 0, 0, nil, 0
	local t, holdTimer = 0, 0

	while t < total do
		local dt = RunService.Heartbeat:Wait()
		if cancelled() then return "cancelled" end
		t += dt

		-- здоровье читаем с сохранённого Humanoid: так видно и последний удар перед смертью
		local hp = humanoid.Health
		if t <= settle then
			lastHealth = hp -- стабилизация: приземление не считаем уроном трубы
		else
			if hp < lastHealth then
				local hit = lastHealth - hp
				damage += hit
				peak = math.max(peak, hit)
				firstHit = firstHit or (t - settle)
			end
			lastHealth = hp
		end

		local h, r = characterParts()
		if player.Character ~= initialChar or h ~= humanoid or not r then
			if damage > 0 then
				finishPipe(idx, "Урон наблюдался",
					damageDetail(damage, firstHit, peak, rubber) .. " · персонаж погиб")
				return "done"
			end
			return "lost"
		end

		if teleportEnabled then
			holdTimer += dt
			if holdTimer >= HOLD_INTERVAL then
				holdTimer = 0
				if flatDistance(r.Position, PIPES[idx]) > HOLD_RADIUS then
					rubber += 1
					teleportTo(idx)
				end
			end
		elseif not inZone(r, idx) then
			finishPipe(idx, "Проверка неполная", "персонаж вышел из зоны")
			return "done"
		end

		local phase = (t <= settle) and "стабилизация после ТП"
			or string.format("наблюдение %.1f/%.0f с", t - settle, CHECK_SECONDS)
		info.Text = string.format("[%d/%d] Труба %d · %s\nУрон: %.1f HP · откатов ТП: %d",
			batchIndex, batchTotal, idx, phase, damage, rubber)
	end

	-- 3) вердикт
	if rubber > RUBBER_LIMIT then
		local extra = damage > 0 and string.format(" (урон %.1f HP)", damage) or ""
		finishPipe(idx, "Проверка неполная",
			string.format("сервер возвращал назад %d раз", rubber) .. extra)
	elseif damage > 0 then
		finishPipe(idx, "Урон наблюдался", damageDetail(damage, firstHit, peak, rubber))
	else
		local s = string.format("0 HP за %.0f сек", CHECK_SECONDS)
		if rubber > 0 then s = s .. string.format(" · откатов %d", rubber) end
		finishPipe(idx, "Урон не наблюдался", s)
	end
	return "done"
end

-- Обёртка: если персонаж погиб без урона — ждём респавн и повторяем ту же трубу
-- Возвращает: "done" | "cancelled" | "failed"
local function checkWithRetry(idx, token)
	for attempt = 1, MAX_RETRIES do
		local result = checkPipe(idx, token)
		if result ~= "lost" then return result end

		statuses[idx] = "Проверка неполная"
		details[idx] = string.format("персонаж погиб, повтор %d/%d", attempt, MAX_RETRIES)
		refresh()

		local waited = 0
		while waited < RESPAWN_TIMEOUT and not characterParts() do
			if runToken ~= token then return "cancelled" end
			task.wait(0.5)
			waited += 0.5
		end
		if not characterParts() then return "failed" end
		task.wait(1)
	end
	finishPipe(idx, "Проверка неполная", string.format("персонаж погиб %d раз подряд", MAX_RETRIES))
	return "done"
end

----------------------------------------------------------------
-- Запуск пачки проверок
----------------------------------------------------------------
local function returnHome(pivot)
	if not (returnEnabled and pivot) then return end
	for _ = 1, 2 do
		local _, root = characterParts()
		if not root then return end
		root.AssemblyLinearVelocity = Vector3.zero
		player.Character:PivotTo(pivot)
		task.wait(0.3)
	end
end

local function runWorkflow(list)
	if checking then return end
	if #list == 0 then return end

	local humanoid, root = characterParts()
	if not humanoid or not root then
		info.Text = "Персонаж недоступен"
		return
	end
	if not teleportEnabled then
		if #list > 1 then
			info.Text = "Для проверки всех труб включи ТП"
			return
		end
		if not inZone(root, list[1]) then
			info.Text = string.format("Подойди к трубе %d ближе %.0f studs или включи ТП", list[1], ZONE_RADIUS)
			return
		end
	end

	runToken += 1
	local token = runToken
	checking = true
	batchTotal = #list
	summaryText = ""
	local startPivot = player.Character:GetPivot()

	task.spawn(function()
		local ok, err = pcall(function()
			for n, idx in ipairs(list) do
				if runToken ~= token then break end
				selected = idx
				batchIndex = n
				local result = checkWithRetry(idx, token)
				if result == "cancelled" then
					if statuses[idx] == "Проверяется" then
						statuses[idx] = "Проверка неполная"
						details[idx] = "остановлена"
					end
					break
				elseif result == "failed" then
					statuses[idx] = "Проверка неполная"
					details[idx] = "не дождался респавна"
					break
				end
				task.wait(PAUSE_BETWEEN)
			end
		end)

		returnHome(startPivot)
		checking = false
		batchIndex = 0

		if not ok then
			info.Text = "Ошибка: " .. tostring(err)
		elseif #list > 1 then
			local hit = damagedList()
			summaryText = "Итог: урон на трубах " .. (#hit > 0 and table.concat(hit, ", ") or "не наблюдался")
		end
		refresh()
	end)
end

local function stop()
	if checking then
		runToken += 1 -- поток сам завершится, вернёт на место и снимет флаг checking
	end
end

