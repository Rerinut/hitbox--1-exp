local function stopAll()
	isRunning = false
	setNoClip(false)
	setStatus("Остановлено", THEME.statusIdle)
end

btnStop.MouseButton1Click:Connect(stopAll)

btnStart.MouseButton1Click:Connect(function()
	if isRunning then return end
	isRunning = true

	task.spawn(function()
		for _, pipe in ipairs(PIPE_POSITIONS) do
			if not isRunning then break end

			local ok = processPipe(pipe, setStatus)
			if not ok and isRunning then
				setStatus(string.format("Пропуск %s (нет урона)", pipe.name), THEME.statusWarn)
				task.wait(0.3)
			end
		end

		if isRunning then
			setStatus("Все трубы пройдены!", THEME.statusOk)
			isRunning = false
		end
	end)
end)

