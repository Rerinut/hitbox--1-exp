local function initWatermark()
    local RunService = game:GetService("RunService")

    local gui = Instance.new("ScreenGui")
    gui.Name = "AXIOS_Watermark"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 999

    local parentGui = (gethui and gethui()) or game:GetService("CoreGui")
    local okParent = pcall(function() gui.Parent = parentGui end)
    if not okParent then
        gui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    end

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0, 280, 0, 24)
    label.Position = UDim2.new(0, 8, 0, 8)
    label.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    label.BackgroundTransparency = 0.25
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.Font = Enum.Font.Code
    label.TextSize = 14
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Text = "AXIOS"
    label.Visible = false
    label.Parent = gui

    getgenv().uiLE.WatermarkGui = gui
    getgenv().uiLE.WatermarkLabel = label

    local acc = 0
    Connections.track("Watermark", RunService.Heartbeat:Connect(function(dt)
        if not label.Visible then return end
        acc = acc + dt
        if acc < 0.2 then return end
        acc = 0

        local fps = math.floor(1 / math.max(dt, 1e-4))
        local ping = 0
        local okp, val = pcall(function()
            return game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()
        end)
        if okp and val then ping = math.floor(val) end

        local status = safeGet("ModifyLimbs") and "ON" or "OFF"
        label.Text = string.format("AXIOS | FPS: %d | Ping: %dms | Limbs: %s", fps, ping, status)
    end))
end

