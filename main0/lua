	local pos = UDim2.fromOffset(8, y)
	if side == "left" then
		size = UDim2.new(0.5, -12, 0, 32)
	elseif side == "right" then
		size = UDim2.new(0.5, -12, 0, 32)
		pos = UDim2.new(0.5, 4, 0, y)
	end
	local b = instance("TextButton", parent, {
		Size = size,
		Position = pos,
		BackgroundColor3 = color or Color3.fromRGB(62, 85, 118),
		TextColor3 = Color3.new(1, 1, 1),
		Text = label, Font = Enum.Font.Gotham, TextSize = 13,
	})
	instance("UICorner", b, {CornerRadius = UDim.new(0, 6)})
	return b
end

