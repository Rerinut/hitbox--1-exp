	local startPos = nil

	mainFrame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = mainFrame.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			mainFrame.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)
end

--------------------------------------------------------------------
-- УПРАВЛЕНИЕ ЦИКЛОМ И ОЧИСТКА РЕСУРСОВ
--------------------------------------------------------------------
local function stopCycle()
	isRunning = false
	if currentTween then
		currentTween:Cancel()
		currentTween = nil
	end
	setFlightMode(false)
	setStatus("Остановлено", THEME.statusIdle)
end

btnStop.MouseButton1Click:Connect(stopCycle)

btnStart.MouseButton1Click:Connect(function()
	if isRunning then return end
	isRunning = true

	task.spawn(function()
		for _, pipe in ipairs(PIPE_POSITIONS) do
			if not isRunning then break end

			local success = processPipe(pipe, setStatus)
			if not success and isRunning then
				setStatus(string.format("Пропуск %s: нет урона", pipe.name), THEME.statusWarn)
				task.wait(0.5)
			end
		end

		if isRunning then
			setFlightMode(false)
			setStatus("Маршрут завершен!", THEME.statusOk)
			isRunning = false
		end
	end)
end)

inputConnection = UserInputService.InputBegan:Connect(function(input, processed)
	if not processed and input.KeyCode == CONFIG.TOGGLE_KEY then
		mainFrame.Visible = not mainFrame.Visible
	end
end)

-- Автоматическая отписка от всех событий при перезапуске скрипта
screenGui.Destroying:Connect(function()
	stopCycle()
	if inputConnection then
		inputConnection:Disconnect()
		inputConnection = nil
	end
end)
