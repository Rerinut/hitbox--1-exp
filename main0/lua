	Vector3.new(-3806.71, 98.50, 5093.26),
	Vector3.new(-3960.26, 106.50, 5281.30),
	Vector3.new(-3671.71, 93.50, 5389.35),
	Vector3.new(-3616.63, 93.50, 5278.25),
	Vector3.new(-3419.04, 93.50, 5230.96),
	Vector3.new(-3470.64, 93.50, 5412.19),
	Vector3.new(-3425.63, 95.00, 5463.00),
	Vector3.new(-3527.75, 93.50, 5588.77),
	Vector3.new(-3464.73, 110.50, 5665.48),
	Vector3.new(-3568.99, 93.50, 5742.89),
}

-- НАСТРОЙКИ
local CHECK_SECONDS = 5        -- сколько секунд наблюдать урон на каждой трубе
local SETTLE_TIME = 0.8        -- после ТП урон не считаем (падение/приземление)
local TELEPORT_ATTEMPTS = 3    -- первичные повторы ТП (сервер может откатывать)
local TELEPORT_PAUSE = 0.3
local TELEPORT_HEIGHT = 3      -- на сколько studs выше точки трубы ставить персонажа
local HOLD_INTERVAL = 0.25     -- как часто возвращать на трубу при сносе
local HOLD_RADIUS = 10         -- дальше этого от трубы (по горизонтали) = вернуть
local RUBBER_LIMIT = 6         -- больше откатов = проверка неполная
local MAX_RETRIES = 3          -- повторы трубы, если персонаж погиб без урона
local RESPAWN_TIMEOUT = 30     -- сколько ждать респавн, сек
local PAUSE_BETWEEN = 0.5      -- пауза между трубами
local ZONE_RADIUS = 16         -- для ручного режима (без ТП): горизонтальный радиус
local MAX_HEIGHT_DIFF = 30     -- допустимая разница по высоте
local HOTKEY = Enum.KeyCode.RightShift

-- СОСТОЯНИЕ
local statuses = table.create(#PIPES, "Не проверена")
local details = table.create(#PIPES, "")
local selected = 1
local runToken = 0
local checking = false
local batchIndex, batchTotal = 0, 0
local teleportEnabled = true
local returnEnabled = true
local summaryText = ""
local connections = {}

local function listen(signal, callback)
	local c = signal:Connect(callback)
	table.insert(connections, c)
	return c
end

----------------------------------------------------------------
-- Вспомогательные функции
----------------------------------------------------------------
local function characterParts()
	local c = player.Character
	if not c then return end
	local h = c:FindFirstChildOfClass("Humanoid")
	local root = c:FindFirstChild("HumanoidRootPart")
	if h and root and h.Health > 0 then return h, root end
end

local function flatDistance(a, b)
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

local function inZone(root, i)
	local p = PIPES[i]
	return flatDistance(root.Position, p) <= ZONE_RADIUS
		and math.abs(root.Position.Y - p.Y) <= MAX_HEIGHT_DIFF
end

local function teleportTo(i)
	local _, root = characterParts()
	if not root then return false end
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	player.Character:PivotTo(CFrame.new(PIPES[i] + Vector3.new(0, TELEPORT_HEIGHT, 0)))
	return true
end

local function damagedList()
	local list = {}
	for i = 1, #PIPES do
		if statuses[i] == "Урон наблюдался" then table.insert(list, tostring(i)) end
	end
	return list
end

