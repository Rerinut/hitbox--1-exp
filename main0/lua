-- [FIX] loadRemoteChangelogs — теперь кэширует JSON локально и
-- умеет работать оффлайн, если GitHub/Rubis недоступны
-- ==================================================================
local function loadRemoteChangelogs()
    local changelogURLs = {
        "https://raw.githubusercontent.com/AAPVdev/scripts/refs/heads/main/changelogs.json",
        "https://api.rubis.app/v2/scrap/5olUvAKK803Tl2js/raw"
    }
    local cacheFile = "AXIOS_Changelog_Cache.json"

    for _, url in ipairs(changelogURLs) do
        local content = fetchUrlList({url})
        if content then
            local success, data = pcall(function() return game:GetService("HttpService"):JSONDecode(content) end)
            if success and type(data) == "table" then
                if writefile then
                    pcall(function() writefile(cacheFile, content) end)
                end
                for i = #data, 1, -1 do
                    getgenv().ChangelogHelper.add(data[i])
                end
                return true
            else
                Logger.warn("Failed to decode changelog JSON from " .. url)
            end
        end
    end

    if isfile and readfile and isfile(cacheFile) then
        local okr, cached = pcall(readfile, cacheFile)
        if okr and cached and cached ~= "" then
            local ok2, data = pcall(function() return game:GetService("HttpService"):JSONDecode(cached) end)
            if ok2 and type(data) == "table" then
                Logger.warn("Loaded changelogs from local cache (offline fallback)")
                for i = #data, 1, -1 do
                    getgenv().ChangelogHelper.add(data[i])
                end
                return true
            end
        end
    end

    Logger.error("Failed to load changelogs from network and cache")
    return false
end

