--------------------------------------------------------------------
-- ЗАПУСК И ОТМЕНА РАБОЧИХ ПОТОКОВ (один активный за раз)
-- force = перехватить управление у работающего прогона (для быстрых ТП)
--------------------------------------------------------------------
local function cancelRun()
	runId += 1 -- все живые циклы увидят чужой id и завершатся
	setNoClip(false)
	stopAiming()
end

local function startRun(fn, force)
	if isBusy and not force then return end
	cancelRun()
	local id = runId
	isBusy = true

	task.spawn(function()
		local ok, err = pcall(fn, id)
		setNoClip(false)
		stopAiming()
		isBusy = false
		if not ok and isCurrent(id) then
			setStatus("Ошибка: " .. tostring(err), THEME.btnStop)
		end
	end)
end

for index, pipe in ipairs(PIPE_POSITIONS) do
	local pBtn = create("TextButton", {
		LayoutOrder = index,
		Size = UDim2.new(1, -6, 0, 26),
		BackgroundColor3 = THEME.bg,
		BorderSizePixel = 0,
		TextColor3 = THEME.text,
		Text = string.format("Труба %d (держать до урона)", pipe.id),
		Font = Enum.Font.Gotham,
		TextSize = 12,
		Parent = pipesListFrame,
	})
	decor(pBtn, 6)

	pBtn.MouseButton1Click:Connect(function()
		startRun(function(id)
			if teleportUntilVerifiedDamage(pipe, id, setStatus) then
				setStatus(string.format("%s пройдена!", pipe.name), THEME.statusOk)
			elseif isCurrent(id) then
				setStatus(string.format("%s: не дождались урона", pipe.name), THEME.statusWarn)
			end
		end)
	end)
end

