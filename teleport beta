--------------------------------------------------------------------
-- ФИЗИКА И ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
--------------------------------------------------------------------
local function setNoClip(state)
	if noclipConn then
		noclipConn:Disconnect()
		noclipConn = nil
	end

	if state then
		noclipConn = RunService.Stepped:Connect(function()
			local char = player.Character
			if char then
				for _, part in ipairs(char:GetDescendants()) do
					if part:IsA("BasePart") then
						if part.CanCollide then
							noclipChanged[part] = true
							part.CanCollide = false
						end
						part.CanTouch = true -- Гарантируем работу .Touched для получения урона от трубы
					end
				end
			end
		end)
	else
		-- Возвращаем коллизии, которые отключили сами
		for part in pairs(noclipChanged) do
			if part.Parent then
				part.CanCollide = true
			end
		end
		table.clear(noclipChanged)
	end
end

local function getCharParts()
	local char = player.Character or player.CharacterAdded:Wait()
	local hrp = char:WaitForChild("HumanoidRootPart", 10)
	local hum = char:WaitForChild("Humanoid", 10)
	return char, hrp, hum
end

-- Ожидание появления живого персонажа (с учетом остановки)
local function waitForRespawn()
	while isRunning do
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if hum and hrp and hum.Health > 0 then
			task.wait(1.2)
			return
		end
		task.wait(0.25)
	end
end

local function equipTool()
	local char = player.Character
	if not char then return nil end
	local tool = char:FindFirstChildOfClass("Tool")
	if tool then return tool end

	local backpack = player:FindFirstChild("Backpack")
	if not backpack then return nil end

	if CONFIG.TOOL_NAME then
		tool = backpack:FindFirstChild(CONFIG.TOOL_NAME)
	else
		tool = backpack:FindFirstChildOfClass("Tool")
	end

	if tool then
		tool.Parent = char
		return nil -- только что экипировали: даем серверу увидеть тулзу в руках,
		           -- иначе первый Activate уходит "в молоко" (часть фикса урона)
	end
	return nil
end

local function quickTeleport(targetPos, updateStatus)
	local _, hrp, hum = getCharParts()
	if not hrp or not hum or hum.Health <= 0 then return end

	pcall(function()
		player:RequestStreamAroundAsync(targetPos, CONFIG.STREAM_TIMEOUT)
	end)

	local dest = CFrame.new(targetPos + Vector3.new(0, CONFIG.TELEPORT_HEIGHT_OFFSET, 0))
	local startTime = tick()

	-- Удерживаем позицию и имитируем "постоянные прыжки/движения" в течение CONFIG.SPECIAL_HOLD_TIME секунд
	while tick() - startTime < CONFIG.SPECIAL_HOLD_TIME do
		if not hrp.Parent or hum.Health <= 0 then break end

		hrp.CFrame = dest
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero

		-- Вызываем прыжок или микро-колебание, чтобы сервер точно зафиксировал активность
		if hum.FloorMaterial ~= Enum.Material.Air then
			hum:ChangeState(Enum.HumanoidStateType.Jumping)
		end

		local timeLeft = CONFIG.SPECIAL_HOLD_TIME - (tick() - startTime)
		if updateStatus then
			updateStatus(string.format("Удержание позиции (%.1fс)...", timeLeft), THEME.statusWarn)
		end

		task.wait(0.1)
	end
end

--------------------------------------------------------------------
-- СТРОГИЙ ЗАХВАТ ТРУБЫ ДО ПОДТВЕРЖДЕННОГО УРОНА
--------------------------------------------------------------------
local function teleportUntilVerifiedDamage(pipe, updateStatus)
	pcall(function()
		player:RequestStreamAroundAsync(pipe.pos, CONFIG.STREAM_TIMEOUT)
	end)

	local basePos = pipe.pos + Vector3.new(0, CONFIG.TELEPORT_HEIGHT_OFFSET, 0)

	while isRunning do
		local _, hrp, hum = getCharParts()
		if not hrp or not hum then
			task.wait(0.2)
			continue
		end

		-- Если персонаж погиб, ждем респавна и остаемся на ЭТОЙ ЖЕ трубе
		if hum.Health <= 0 then
			updateStatus("Смерть! Ждем респавн для " .. pipe.name, THEME.statusWarn)
			waitForRespawn()
			continue
		end

		local tookVerifiedDamage = false
		local sensorArmed = false
		local stableSince = tick()
		local lastHealth = hum.Health
		local lastHit = 0
		local lastTp = 0
		local stepAngle = 0

		-- Слушатель урона: срабатывает ТОЛЬКО если датчик взведен и мы реально у трубы
		local healthConn
		healthConn = hum.HealthChanged:Connect(function(newHealth)
			if newHealth <= 0 then return end

			local distToPipe = (hrp.Position - basePos).Magnitude
			local isAtPipe = distToPipe <= CONFIG.MAX_VALID_DIST

			if sensorArmed and isAtPipe and (lastHealth - newHealth) >= CONFIG.DAMAGE_EPSILON then
				tookVerifiedDamage = true
			else
				-- Игнорируем ложный/остаточный урон и обновляем базу ХП
				lastHealth = newHealth
			end
		end)

		setNoClip(true)

		while isRunning and not tookVerifiedDamage and hum.Health > 0 and hrp.Parent do
			-- Проверяем, не отбросил ли нас сервер ДО следующего принудительного ТП
			local currentDist = (hrp.Position - basePos).Magnitude
			if currentDist > CONFIG.MAX_VALID_DIST then
				-- Нас откатило! Сбрасываем таймер стабилизации и блокируем датчик
				sensorArmed = false
				stableSince = tick()
				lastHealth = hum.Health
				lastTp = 0 -- вернуть немедленно, не дожидаясь паузы
				updateStatus(string.format("%s: откат! Возвращаем...", pipe.name), THEME.statusWarn)
			else
				-- Мы находимся у трубы: проверяем, прошло ли время стабилизации
				if not sensorArmed then
					local elapsed = tick() - stableSince
					if elapsed >= CONFIG.STABILIZE_TIME then
						sensorArmed = true
						lastHealth = hum.Health
						updateStatus(string.format("%s: датчик активен, ждем урон", pipe.name), THEME.statusOk)
					else
						updateStatus(string.format("%s: закрепление (%.1fс)...", pipe.name, CONFIG.STABILIZE_TIME - elapsed), THEME.btnAction)
					end
				end
			end

			-- ТЕЛЕПОРТ С ПАУЗОЙ (главная часть фикса урона):
			-- позицию пишем один раз, потом TELEPORT_PAUSE секунд её не трогаем —
			-- сервер видит спокойного игрока и валидирует урон по трубе
			if tick() - lastTp >= CONFIG.TELEPORT_PAUSE then
				lastTp = tick()

				-- Микро-смещение каждый раз новое, чтобы .Touched трубы продолжал срабатывать
				stepAngle = stepAngle + 1.2
				local jiggleOffset = Vector3.new(
					math.cos(stepAngle) * CONFIG.JIGGLE_RADIUS,
					0,
					math.sin(stepAngle) * CONFIG.JIGGLE_RADIUS
				)

				hrp.CFrame = CFrame.new(basePos + jiggleOffset)
				lastHit = 0 -- первый выстрел этого цикла не должен сгореть из-за интервала
			end

			-- В паузу позицию НЕ трогаем, но скорости обнуляем: с ноклипом
			-- персонаж иначе медленно падает, и часть выстрелов уходит "в движении"
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero

			-- Автоудар инструментом: только в "чистом" окне после телепорта —
			-- не сразу (сервер должен принять новую позицию) и не в конце паузы
			local sinceTp = tick() - lastTp
			if sinceTp >= CONFIG.SHOOT_DELAY_AFTER_TP and sinceTp <= CONFIG.SHOOT_DELAY_AFTER_TP + CONFIG.SHOOT_WINDOW then
				if tick() - lastHit >= CONFIG.HIT_INTERVAL then
					lastHit = tick()
					local tool = equipTool()
					if tool then tool:Activate() end
				end
			end

			task.wait(CONFIG.TP_LOOP_INTERVAL)
		end

		healthConn:Disconnect()
		setNoClip(false)

		if tookVerifiedDamage then
			updateStatus(string.format("Урон от %s подтвержден!", pipe.name), THEME.statusOk)
			task.wait(CONFIG.BETWEEN_PIPES_PAUSE)
			return true
		end
	end

	return false
end

