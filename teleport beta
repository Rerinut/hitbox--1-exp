	SHOOT_WINDOW = 0.5,            -- сколько сек после телепорта разрешена стрельба (дальше ждем следующий ТП)
	STABILIZE_TIME = 0.8,          -- сколько сек нужно простоять у новой трубы без отката до включения датчика
	MAX_VALID_DIST = 4.5,          -- макс. радиус от трубы, внутри которого урон считается валидным
	JIGGLE_RADIUS = 0.25,          -- микро-смещение для срабатывания серверного .Touched трубы
	HIT_INTERVAL = 0.35,           -- интервал ударов инструментом (сек)
	DAMAGE_EPSILON = 0.1,          -- минимальный урон для срабатывания датчика
