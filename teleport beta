local function startRun(fn)
	-- isBusy защищает от второго параллельного цикла после быстрого Стоп -> Старт
	if isRunning or isBusy then return end
	isRunning = true
	isBusy = true

	task.spawn(function()
		pcall(fn) -- ошибка внутри цикла не должна навсегда блокировать кнопки
		setNoClip(false)
		isBusy = false
	end)
end

