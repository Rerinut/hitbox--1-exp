-- Хелпер: создание инстанса из таблицы свойств (Parent ставится последним)
local function create(className, props)
	local inst = Instance.new(className)
	for k, v in pairs(props) do
		if k ~= "Parent" then
			inst[k] = v
		end
	end
	inst.Parent = props.Parent
	return inst
end

-- Хелпер: скругление + обводка одним вызовом
local function decor(obj, cornerRadius, strokeColor, strokeThickness)
	if cornerRadius then
		create("UICorner", { CornerRadius = UDim.new(0, cornerRadius), Parent = obj })
	end
	if strokeColor or strokeThickness then
		create("UIStroke", {
			Color = strokeColor or THEME.stroke,
			Thickness = strokeThickness or 1,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Parent = obj,
		})
	end
end

