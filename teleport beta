-- ФИЗИКА И ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
--------------------------------------------------------------------
local noclipConn = nil
local noclipChanged = {} -- части, у которых мы отключили CanCollide

local function setNoClip(state)
	if noclipConn then
		noclipConn:Disconnect()
		noclipConn = nil
	end

	if state then
		noclipConn = RunService.Stepped:Connect(function()
			local char = player.Character
			if not char then return end
			for _, part in ipairs(char:GetDescendants()) do
				if part:IsA("BasePart") then
					if part.CanCollide then
						noclipChanged[part] = true
						part.CanCollide = false
					end
					if not part.CanTouch then
						part.CanTouch = true -- нужен для .Touched у трубы
					end
				end
			end
		end)
	else
		-- Возвращаем коллизии, которые отключили сами
		for part in pairs(noclipChanged) do
			if part.Parent then
				part.CanCollide = true
			end
		end
		table.clear(noclipChanged)
	end
end

--------------------------------------------------------------------
-- ПРИЦЕЛ НА ТРУБУ
-- Большинство оружейных тулз в Roblox рейкастят от камеры (или от курсора,
-- чей луч строится от камеры). Раньше скрипт не задавал ни позу, ни камеру —
-- выстрелы уходили в случайную сторону. Плюс луч, начавшийся ВНУТРИ детали
-- трубы, не регистрирует попадание по ней самой, поэтому камеру выносим
-- наружу на AIM_CAMERA_DISTANCE.
--------------------------------------------------------------------
local AIM_BIND_NAME = "NaramatoAim"
local aimBound = false

local function stopAiming()
	if aimBound then
		aimBound = false
		RunService:UnbindFromRenderStep(AIM_BIND_NAME)
	end
end

local function startAiming(target)
	stopAiming()
	if not target or CONFIG.AIM_CAMERA_DISTANCE <= 0 then return end

	aimBound = true
	local standDir = Vector3.new(1, 0, 0)
	local anchor = target + standDir * CONFIG.AIM_CAMERA_DISTANCE + Vector3.new(0, CONFIG.AIM_CAMERA_HEIGHT, 0)

	-- приоритет выше дефолтного контроллера камеры, иначе он перезапишет CFrame
	RunService:BindToRenderStep(AIM_BIND_NAME, Enum.RenderPriority.Camera.Value + 1, function()
		if not aimBound then return end
		local cam = workspace.CurrentCamera
		if cam then
			cam.CFrame = CFrame.lookAt(anchor, target)
		end
	end)
end

-- Ищем реальную деталь трубы рядом с координатой из списка и целимся в её центр
local function findPipeCenter(pos)
	local char = player.Character
	local best, bestDist = nil, math.huge
	for _, part in ipairs(workspace:GetPartBoundsInRadius(pos, CONFIG.PIPE_SCAN_RADIUS)) do
		if part:IsA("Terrain") then continue end
		if char and part:IsDescendantOf(char) then continue end
		if math.max(part.Size.X, part.Size.Y, part.Size.Z) > 40 then continue end -- пол/стены карты
		local d = (part.Position - pos).Magnitude
		if d < bestDist then
			bestDist = d
			best = part
		end
	end
	return best and best.Position or pos
end

local function getCharParts()
	local char = player.Character or player.CharacterAdded:Wait()
	local hrp = char:WaitForChild("HumanoidRootPart", 10)
	local hum = char:WaitForChild("Humanoid", 10)
	return char, hrp, hum
end

-- Ожидание появления живого персонажа (с учетом отмены запуска)
local function waitForRespawn(id)
	while isCurrent(id) do
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if hum and hrp and hum.Health > 0 then
			task.wait(1.2)
			return
		end
		task.wait(0.25)
	end
end

local function equipTool()
	local char = player.Character
	if not char then return nil end

	local tool = char:FindFirstChildOfClass("Tool")
	if tool then return tool end

	local backpack = player:FindFirstChild("Backpack")
	if not backpack then return nil end

	if CONFIG.TOOL_NAME then
		tool = backpack:FindFirstChild(CONFIG.TOOL_NAME)
	else
		tool = backpack:FindFirstChildOfClass("Tool")
	end

	if tool then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			hum:EquipTool(tool)
		else
			tool.Parent = char
		end
		-- Экипировка должна дойти до сервера (~0.1с): Activate в тот же тик
		-- сервер отбрасывает — стреляем со следующего интервала
		return nil
	end
	return nil
end

local function quickTeleport(targetPos, id, updateStatus, holdTime)
	holdTime = holdTime or 5
	local _, hrp, hum = getCharParts()
	if not hrp or not hum or hum.Health <= 0 then return end

	pcall(player.RequestStreamAroundAsync, player, targetPos, CONFIG.STREAM_TIMEOUT)

	local dest = CFrame.new(targetPos + Vector3.new(0, CONFIG.TELEPORT_HEIGHT_OFFSET, 0))
	local startTime = os.clock()

	while os.clock() - startTime < holdTime do
		if not isCurrent(id) or not hrp.Parent or hum.Health <= 0 then break end

		hrp.CFrame = dest
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero

		-- Прыжок, чтобы сервер зафиксировал активность (отключается QUICK_TP_JUMP)
		if CONFIG.QUICK_TP_JUMP and hum.FloorMaterial ~= Enum.Material.Air then
			hum:ChangeState(Enum.HumanoidStateType.Jumping)
		end

		if updateStatus then
			updateStatus(string.format("Удержание позиции (%.1fс)...", holdTime - (os.clock() - startTime)), THEME.statusWarn)
		end

		task.wait(0.1)
	end
end

--------------------------------------------------------------------
-- СТРОГИЙ ЗАХВАТ ТРУБЫ ДО ПОДТВЕРЖДЕННОГО УРОНА
--------------------------------------------------------------------
local function teleportUntilVerifiedDamage(pipe, id, updateStatus)
	pcall(player.RequestStreamAroundAsync, player, pipe.pos, CONFIG.STREAM_TIMEOUT)

	local standDir = Vector3.new(1, 0, 0)
	local aimPoint = findPipeCenter(pipe.pos)
	local basePos = pipe.pos + standDir * CONFIG.STAND_DISTANCE + Vector3.new(0, CONFIG.TELEPORT_HEIGHT_OFFSET, 0)
	local startedAt = os.clock()

	-- Если стоим ровно над центром трубы (STAND_DISTANCE = 0), lookAt на сам
	-- центр вырождается — разворачиваем персонажа "сквозь" трубу наружу
	local facePoint = aimPoint
	if (Vector3.new(basePos.X, 0, basePos.Z) - Vector3.new(aimPoint.X, 0, aimPoint.Z)).Magnitude < 0.05 then
		facePoint = aimPoint + standDir * 2
	end

	setNoClip(true)
	if CONFIG.AIM_AT_PIPE then
		startAiming(aimPoint)
	end

	while isCurrent(id) do
		if CONFIG.PIPE_TIMEOUT > 0 and os.clock() - startedAt >= CONFIG.PIPE_TIMEOUT then
			updateStatus(string.format("%s: не дождались урона за %dс, пропускаем", pipe.name, CONFIG.PIPE_TIMEOUT), THEME.statusWarn)
			stopAiming()
			return false
		end

		local _, hrp, hum = getCharParts()
		if not hrp or not hum then
			task.wait(0.2)
			continue
		end

		-- Если персонаж погиб, ждем респавна и остаемся на ЭТОЙ ЖЕ трубе
		if hum.Health <= 0 then
			updateStatus("Смерть! Ждем респавн для " .. pipe.name, THEME.statusWarn)
			waitForRespawn(id)
			continue
		end

		local tookVerifiedDamage = false
		local sensorArmed = false
		local stableSince = os.clock()
		local lastHealth = hum.Health
		local lastHit = 0
		local stepAngle = 0

		-- Слушатель урона: срабатывает ТОЛЬКО если датчик взведен и мы реально у трубы
		local healthConn
		healthConn = hum.HealthChanged:Connect(function(newHealth)
			if newHealth <= 0 then return end

			local distToPipe = (hrp.Position - basePos).Magnitude
			local isAtPipe = distToPipe <= CONFIG.MAX_VALID_DIST
			local damage = lastHealth - newHealth

			if sensorArmed and isAtPipe and damage >= CONFIG.DAMAGE_EPSILON then
				tookVerifiedDamage = true
			end
			lastHealth = newHealth
		end)

		while isCurrent(id) and not tookVerifiedDamage and hum.Health > 0 and hrp.Parent do
			-- Проверяем, не отбросил ли нас сервер ДО следующего принудительного ТП
			local currentDist = (hrp.Position - basePos).Magnitude
			if currentDist > CONFIG.MAX_VALID_DIST then
				-- Нас откатило! Сбрасываем таймер стабилизации и блокируем датчик
				sensorArmed = false
				stableSince = os.clock()
				lastHealth = hum.Health
				updateStatus(string.format("%s: откат! Возвращаем...", pipe.name), THEME.statusWarn)
			elseif not sensorArmed then
				-- Мы у трубы: проверяем, прошло ли время стабилизации
				local elapsed = os.clock() - stableSince
				if elapsed >= CONFIG.STABILIZE_TIME then
					sensorArmed = true
					lastHealth = hum.Health
					updateStatus(string.format("%s: датчик активен, ждем урон", pipe.name), THEME.statusOk)
				else
					updateStatus(string.format("%s: закрепление (%.1fс)...", pipe.name, CONFIG.STABILIZE_TIME - elapsed), THEME.btnAction)
				end
			end

			-- Микро-колебание на месте, чтобы физика Roblox вызывала .Touched у трубы
			stepAngle += 1.2
			local jiggleOffset = Vector3.new(
				math.cos(stepAngle) * CONFIG.JIGGLE_RADIUS,
				0,
				math.sin(stepAngle) * CONFIG.JIGGLE_RADIUS
			)

			hrp.CFrame = CFrame.lookAt(basePos + jiggleOffset, facePoint)
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero

			-- Автоудар инструментом (pcall: кривая тулза не должна ронять весь прогон)
			if os.clock() - lastHit >= CONFIG.HIT_INTERVAL then
				lastHit = os.clock()
				local tool = equipTool()
				if tool then pcall(tool.Activate, tool) end
			end

			task.wait(CONFIG.TP_LOOP_INTERVAL)
		end

		healthConn:Disconnect()

		if tookVerifiedDamage then
			updateStatus(string.format("Урон от %s подтвержден!", pipe.name), THEME.statusOk)
			stopAiming()
			task.wait(CONFIG.BETWEEN_PIPES_PAUSE)
			return true
		end
	end

	stopAiming()
	return false
end

